# perch-look 0.02: Perch's eye on a display, for bots that were about to take a screenshot. The words come from the apps
# themselves (their accessibility tree, AT-SPI). A window that gives no words (an old or custom-drawn app, a game, a remote
# desktop) is read from its pixels here on the machine (Tesseract, no tokens) as R lines; it is read again only when its
# pixels change. Pixels for a bot only for what really is a picture, cropped.
#
#   perch-look screen [-d :2] [all]       what is on that display now (all = text scrolled out of view too)
#   perch-look changes [-d :2]            only what changed since the last look at that display (+ appeared, - went)
#   perch-look pixels x,y,w,h [-d :2]     the pixels of that box as a PNG (a photo, a chart, a video frame), never the screen
#
# Lines (shape stated once in the skill, bare values here; boxes are x,y wxh in screen pixels, words always quoted):
#   W x,y wxh app 'title'          a window                     F role 'name' x,y wxh         what has the keyboard focus
#   t x,y wxh 'text'               words (one line of a text)   b x,y wxh role 'label' [on|off]  a button, menu, tab, tick box
#   i x,y wxh role 'name' 'value'  a box you type into          p x,y wxh role 'name'          a picture: pixels only by `pixels`
#   X x,y wxh 'title'              a window that gives no words (no accessibility); its words read from pixels follow as:
#   R x,y wxh 'text'               read from pixels: may hold mistakes (PERCH_READ=off: not read)
#   ! ...                          what happened (no change, no words on the display)
import hashlib, json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
CROP = os.path.join(HERE, "perch-crop")
sys.path[:0] = [HERE, "/usr/lib/perch"]                # the shared reader: next to this script, or where the package puts it
import perch_read as reader                            # noqa: E402
USAGE = "usage: perch-look [--mode auto|words|ocr|picture] [--cut N] [--zoom N] screen [-d :2] [all] | changes [-d :2] | pixels x,y,w,h [-d :2]"

import perch_settings as settings                      # noqa: E402
try:
    opt, args = settings.load(sys.argv[1:])                 # saved < PERCH_MODE/CUT/ZOOM < --mode/--cut/--zoom on this call
except ValueError as e:
    print(f"err {e}"); sys.exit(1)
disp = ":2"
if "-d" in args:
    i = args.index("-d")
    if i + 1 >= len(args): sys.exit(USAGE)
    disp = args[i + 1]; del args[i:i + 2]
if not args or args[0] not in ("screen", "changes", "pixels") or not re.fullmatch(r":\d+", disp):
    sys.exit(USAGE)
cmd = args[0]
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "perch-look")
os.makedirs(RUN, mode=0o700, exist_ok=True)
os.environ["DISPLAY"] = disp                       # the accessibility bus is found on this display (its root window says where)

def q(t):
    t = re.sub(r"\s+$", "", str(t or ""))
    return "'" + "".join(("\\" + c) if c in "\\'" else ("\\n" if c == "\n" else (c if c >= " " else "?")) for c in t) + "'"

if cmd == "pixels":
    m = re.fullmatch(r"(\d+),(\d+),(\d+),(\d+)", args[1] if len(args) > 1 else "")
    if not m: sys.exit(USAGE)
    x, y, w, h = map(int, m.groups())
    out = os.path.join(RUN, f"pixels-{disp[1:]}-{x}-{y}-{w}-{h}.png")
    r = subprocess.run([CROP, f"{x},{y},{w},{h}", "-d", disp, "-o", out, "-p", "0"], capture_output=True, text=True)
    if r.returncode: sys.exit("err " + (r.stderr.strip() or "crop failed"))
    path, size = r.stdout.split()
    cw, ch = map(int, size.split("x"))
    print(f"pixels {path} {size} ~{cw * ch // 750} tokens"); sys.exit(0)

def grab():
    from PIL import ImageGrab
    return ImageGrab.grab(xdisplay=disp)

if opt["mode"] in ("picture", "ocr"):                       # the screen's pixels, not the apps' words
    im = grab()
    if opt["mode"] == "picture":
        print(settings.picture(im, opt["zoom"], os.path.join(RUN, f"screen-{disp[1:]}.png")))
    elif not reader.available():
        print("err ocr needs tesseract (apt install tesseract-ocr)"); sys.exit(1)
    else:
        r = [f"R {x},{y} {w}x{h} {reader.quote(t)}" for x, y, w, h, t in reader.read(im, [(0, 0, im.width, im.height)], page=True)]
        print("\n".join(settings.cut(l, 0 if "all" in args[1:] else opt["cut"]) for l in r) or f"! no words read on {disp}")
    sys.exit(0)

import gi
gi.require_version("Atspi", "2.0")
from gi.repository import Atspi
Atspi.set_timeout(800, 3000)                       # a hung app costs at most a few seconds, never the whole look

ALL = "all" in args[1:]
BUTTON = {"push button", "toggle button", "check box", "radio button", "menu", "menu item", "check menu item", "radio menu item",
          "page tab", "combo box", "link", "spin button", "toggle switch", "list item", "tree item", "table column header"}
PICTURE = {"image", "canvas", "drawing area", "video", "animation", "icon"}
TEXTY = {"label", "static", "heading", "paragraph", "text", "status bar", "table cell", "caption", "terminal", "document text",
         "document frame", "entry", "password text", "editbar", "section", "article", "block quote"}
CHECKED = (Atspi.StateType.CHECKED, Atspi.StateType.PRESSED, Atspi.StateType.SELECTED)

def ext(a):
    try:
        e = a.get_extents(Atspi.CoordType.SCREEN)
        return (e.x, e.y, e.width, e.height) if e.width > 0 and e.height > 0 and e.x > -100000 else None
    except Exception:
        return None

def bx(b): return f"{b[0]},{b[1]} {b[2]}x{b[3]}"

def inside(b, v):                                  # any part of box b within box v
    return b[0] < v[0] + v[2] and b[0] + b[2] > v[0] and b[1] < v[1] + v[3] and b[1] + b[3] > v[1]

def text_lines(a, view):
    """the widget's text, one line per text line with its own box; only lines in view unless all"""
    try:
        n = Atspi.Text.get_character_count(a)
        s = Atspi.Text.get_text(a, 0, n) if n else ""
    except Exception:
        return None
    out, off = [], 0
    for ln in s.split("\n"):
        if ln.strip():
            b = None
            try:
                r = Atspi.Text.get_range_extents(a, off, off + len(ln), Atspi.CoordType.SCREEN)
                b = (r.x, r.y, r.width, r.height) if r.width > 0 and r.x > -100000 else None
            except Exception:
                pass
            if ALL or (b and inside(b, view)):
                out.append((b or view, ln))
        off += len(ln) + 1
    return out

def walk(a, win, out, depth=0):
    try:
        role = a.get_role_name(); ss = a.get_state_set(); name = (a.get_name() or "").strip()
    except Exception:
        return
    if depth and not (ss.contains(Atspi.StateType.SHOWING) and ss.contains(Atspi.StateType.VISIBLE)):
        return                                     # closed menus, hidden tabs: not on the screen
    b = ext(a)
    if b and not inside(b, win) and not ALL:
        return
    if ss.contains(Atspi.StateType.FOCUSED) and b:
        out.append(f"F {role.replace(' ', '-')} {q(name)} {bx(b)}")
    leaf = False
    if role in PICTURE and b and b[2] >= 48 and b[3] >= 48:
        out.append(f"p {bx(b)} {role.replace(' ', '-')} {q(name)}"); leaf = True
    elif role in BUTTON and b:
        st = (" on" if any(ss.contains(s) for s in CHECKED) else " off") if role in ("toggle button", "check box", "radio button", "check menu item", "radio menu item", "toggle switch") else ""
        label = name
        if not label and a.get_child_count() == 0:
            tl = text_lines(a, b); label = " ".join(x for _, x in tl) if tl else ""
        out.append(f"b {bx(b)} {role.replace(' ', '-')} {q(label)}{st}")
        leaf = role not in ("menu", "combo box", "list item", "tree item")
    elif b and ss.contains(Atspi.StateType.EDITABLE):
        tl = text_lines(a, b) or []
        if ss.contains(Atspi.StateType.SINGLE_LINE) or role in ("entry", "password text", "spin button"):
            v = "***" if role == "password text" and tl else " ".join(x for _, x in tl)
            out.append(f"i {bx(b)} {role.replace(' ', '-')} {q(name)} {q(v)}")
        else:
            out.append(f"i {bx(b)} {role.replace(' ', '-')} {q(name)} ''")
            out += [f"t {bx(lb)} {q(x)}" for lb, x in tl]
        leaf = True
    elif role in TEXTY and b:
        tl = text_lines(a, b)
        if tl:
            out += [f"t {bx(lb)} {q(x)}" for lb, x in tl]
        elif name:
            out.append(f"t {bx(b)} {q(name)}")
        leaf = a.get_child_count() == 0 or bool(tl)
    if leaf or depth > 60:
        return
    for i in range(a.get_child_count()):
        try:
            c = a.get_child_at_index(i)
        except Exception:
            continue
        if c is not None:
            walk(c, win, out, depth + 1)

def x_windows():
    """top-level windows on the display that are viewable, from X itself: (box, title)"""
    try:
        r = subprocess.run(["xwininfo", "-root", "-children", "-display", disp], capture_output=True, text=True, timeout=5)
    except Exception:
        return []
    wins = []
    for l in r.stdout.splitlines():
        m = re.match(r'\s+(0x[0-9a-f]+) (?:"(.*?)"(?=: \()|\(has no name\)).*?\s(\d+)x(\d+)\+(-?\d+)\+(-?\d+)\s', l)
        if not m: continue
        wid, title, w, h, x, y = m.group(1), m.group(2) or "", *map(int, m.groups()[2:])
        if w < 8 or h < 8: continue
        try:
            st = subprocess.run(["xwininfo", "-id", wid, "-display", disp], capture_output=True, text=True, timeout=5).stdout
        except Exception:
            continue
        if "IsViewable" in st:
            wins.append(((x, y, w, h), title))
    return wins

lines, have = [], set()
desk = Atspi.get_desktop(0)
napps = desk.get_child_count() if desk else -1
for i in range(max(napps, 0)):
    app = desk.get_child_at_index(i)
    if app is None: continue
    for j in range(app.get_child_count()):
        f = app.get_child_at_index(j)
        if f is None: continue
        try:
            ss = f.get_state_set()
            if not ss.contains(Atspi.StateType.SHOWING): continue
            b = ext(f)
        except Exception:
            continue
        if not b: continue
        title = (f.get_name() or "").strip()
        have.add(title)
        lines.append(f"W {bx(b)} {re.sub(r'[^A-Za-z0-9._-]', '_', app.get_name() or '?')[:24]} {q(title)}")
        walk(f, b, lines)
state = os.path.join(RUN, f"last-{disp[1:]}.json")
try:
    saved = json.load(open(state))
    last, seen = (saved["lines"], saved.get("read", {})) if isinstance(saved, dict) else (saved, {})
except Exception:
    last, seen = None, {}
wordless = [(b, title) for b, title in x_windows() if title not in have]
read_now, shot = {}, None
for b, title in wordless:
    lines.append(f"X {bx(b)} {q(title)}")
    if os.environ.get("PERCH_READ", "on") == "off" or not reader.available():
        continue
    try:
        if shot is None:
            from PIL import ImageGrab
            shot = ImageGrab.grab(xdisplay=disp)
        x, y, w, h = b
        crop = shot.crop((max(0, x), max(0, y), min(shot.width, x + w), min(shot.height, y + h)))
        key = hashlib.sha1(crop.tobytes()).hexdigest()       # the same pixels as last time: the same words, not read again
        prev = seen.get(bx(b))
        found = prev["r"] if prev and prev["k"] == key else [f"R {fx},{fy} {fw}x{fh} {reader.quote(t)}" for fx, fy, fw, fh, t in reader.read(shot, [b])]
        read_now[bx(b)] = {"k": key, "r": found}
        lines += found
    except Exception as e:
        lines.append(f"! could not read the window at {bx(b)}: {type(e).__name__}")
if napps < 0:
    lines.insert(0, f"! no words on {disp}: its accessibility bus does not answer (apps there give pixels only)")

json.dump({"lines": lines, "read": read_now}, open(state, "w"))
if cmd == "changes" and last is not None:
    old, new = set(last), set(lines)
    diff = [f"- {l}" for l in last if l not in new] + [f"+ {l}" for l in lines if l not in old]
    print("\n".join(diff) if diff else "! no change")
else:
    body = "\n".join(lines if ALL else [settings.cut(l, opt["cut"]) for l in lines])   # a full look: each line cut short
    if lines and opt["mode"] == "auto" and not ALL:
        im = grab() if shot is None else shot
        pic = settings.tokens_picture(im.width * opt["zoom"] // 100, im.height * opt["zoom"] // 100)
        if settings.tokens_words(body) > pic:               # the picture is the smaller answer for this screen
            print(f"! picture: the words would be ~{settings.tokens_words(body)} tokens (screen --mode words for them)")
            print(settings.picture(im, opt["zoom"], os.path.join(RUN, f"screen-{disp[1:]}.png"))); sys.exit(0)
    print(body if lines else f"! nothing on {disp}")
