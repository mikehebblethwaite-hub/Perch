# coop-perch-vmlook NAME [changes|window|pixels x,y,w,h]: a bot's look at a Perch VM (coop-perch-vmrun NAME) through the guest
# helper's lines: W app 'title' box (window in front), F app role 'name' box (focus), T app box +'words'.
#   changes (default)  the lines that came since this bot's last look (the first look: the window in front now)
#   window             the window in front now: its W line and everything after it
#   pixels x,y,w,h     only that part of the screen as a PNG (QEMU's own screendump, cropped) -> "pixels FILE wxh ~T tokens"
# The screen settling first: coop-perch-wait -t 10 -p vm-NAME.
import json, os, re, socket, sys

if len(sys.argv) < 2 or not re.fullmatch(r"[a-z0-9-]+", sys.argv[1]):
    sys.exit("usage: coop-perch-vmlook NAME [changes|window|pixels x,y,w,h]")
NAME, what = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "changes")
HERE = os.path.dirname(os.path.realpath(__file__))
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "coop-perch-vm-" + NAME)
TAPE = os.path.join(os.environ.get("PERCH_TAPE_ROOT", os.path.expanduser("~/coop-perch/tape")), "vm-" + NAME, "tape.txt")   # where the VM eye writes
MARK = os.path.join(RUN, "look-mark")
if not os.path.isdir(RUN):
    sys.exit(f"coop-perch-vmlook: no Perch VM '{NAME}' running")
HELPER = re.compile(r"^\S+ ([WFT]) ")


def lines_from(pos):
    with open(TAPE, encoding="utf-8", errors="replace") as f:
        f.seek(pos)
        out = [l.rstrip("\n") for l in f if HELPER.match(l)]
        return out, f.tell()


def window_now():
    out, end = lines_from(0)
    w = max((i for i, l in enumerate(out) if l.split(" ", 2)[1] == "W"), default=0)
    return out[w:], end


if what == "pixels":
    m = re.fullmatch(r"(\d+),(\d+),(\d+),(\d+)", sys.argv[3] if len(sys.argv) > 3 else "")
    if not m:
        sys.exit("pixels x,y,w,h")
    x, y, w, h = map(int, m.groups())
    from PIL import Image
    ppm, png = os.path.join(RUN, "look.ppm"), os.path.join(RUN, f"look-{x}-{y}-{w}x{h}.png")
    c = socket.socket(socket.AF_UNIX); c.connect(os.path.join(RUN, "qmp")); f = c.makefile("rw"); f.readline()
    for cmd in ({"execute": "qmp_capabilities"}, {"execute": "screendump", "arguments": {"filename": ppm}}):
        f.write(json.dumps(cmd) + "\n"); f.flush(); f.readline()
    im = Image.open(ppm).crop((x, y, x + w, y + h)); im.save(png); os.remove(ppm)
    print(f"pixels {png} {im.width}x{im.height} ~{max(1, round(im.width * im.height / 750))} tokens")
    sys.exit(0)

try:
    pos = int(open(MARK).read())
except (OSError, ValueError):
    pos = None
if what == "window" or pos is None or pos > os.path.getsize(TAPE):
    out, end = window_now()
elif what == "changes":
    out, end = lines_from(pos)
else:
    sys.exit("usage: coop-perch-vmlook NAME [changes|window|pixels x,y,w,h]")
open(MARK, "w").write(str(end))
# the time stamp is the eye's, not the screen's: left off to keep the lines short
print("\n".join(l.split(" ", 1)[1] for l in out) if out else "(nothing new)")
