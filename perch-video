# perch-video 0.01: a video player for bots. A video is played the bot's way: not pictures at x frames a second but what the
# video carries as information, earliest first, as short timed lines (only what changed):
#   V 'title' 1:30 1280x720 25fps sound subs:en      the video itself (one line)
#   ch 0:00.0 'Introduction'                          a chapter, from the file
#   sub 0:01.2 'Welcome to the course'                the subtitle/caption track: the exact words, with times
#   cut 0:03.0 2                                      a new scene (shot 2): the picture changed all at once
#   text 0:03.0 'Step 1: turn off the gas'            words on the screen at a cut (slides, signs), read here (no tokens)
#   see 0:03.0 'a man pointing at a boiler'           with --describe: one line from the local vision model at each cut
#   say 0:01.2 sure 9 'ask not what ...'              speech as words (how sure, 1-11, from the speech model's own word confidence)
#                                                     A guess, like half a phone call: pass it on as "I think they said '...'
#                                                     (I cannot be 100% sure)", "it sounded like '...'" when sure is low,
#                                                     with the date when known ("in a speech on 2016-11-30", "around 2016")
#   (old form) say 0:01.2 'ask not what your country...' speech as words (Whisper, here on the machine), when it has no subtitles
#                                                     (or always with --speech); the V line names the language it heard
#   sound 0:03.2-0:05.0 sure 9 'Dog'                  a sound named (YAMNet, 521 kinds, here on the machine), how sure 1-11:
#                                                     pass it on as "it sounded like a dog" (never "there was a dog")
#   s 0:03.2 L7 tone 440Hz b 2-9-3-1-1                its sound, when it changes (perch_sound.py): loudness 1-11, quiet/tone/
#                                                     voice?/music?/noise/bang, five bands 1-11 (low..high); --no-sound: none
#   moves 0:04.2-0:07.9 bottom-left > bottom-right    something moved, from where to where (a 3x3 grid), in one line
#   ! ...                                             what happened (no subtitles, cannot read the file ...)
#   --scenes     the whole video at a glance: one line per scene with everything in it (words, subtitles, movement, sounds)
#   --pack OUT   the lines zipped into OUT (to keep or send); perch-video --unpack OUT gives them back to read (a bot reads
#                the lines, never the zipped bytes: encoded data costs a bot more, not less)
#   --seen [KEY|FILE]  what was kept from videos seen before (no KEY: the list); works with the footage gone
#                      (the person's switch: perch-settings set spoilers on tells it at the start; off by default)
#   --seen KEY --summary  a new summary from the kept lines (the whole video in slices; no need to watch it again)
#   --spoiler KEY|FILE the kept summary (never told at the start: a bot that saw a video before hears only "seen before, about ...")
#   --summary    a lesson line from the local model (Ollama, PERCH_MODEL) saying what the video seems to be about, as a best guess
#   --hint L     try this language first when guessing (it is still checked; the session passes on what a piece needed)
#   --lang L     the speech's language (en, cy, fr ...; default auto)   --quality Q  base (default) | small (better, slower) | ...
# A session a bot drives as it plays (adjust, replay, go on): perch-video NAME play FILE, then read / back N / set lang|quality|speech V /
#   seek T / pause / go / status / stop (perch_play.py)
# Usage: perch-video [--fps N] [--live] [--describe] [--scenes] [--pack OUT] [--lang L] [--quality Q] [--from T] [--to T] FILE|URL
#   --fps N      how often motion is checked (default 4 a second; the scene/motion pass sees a 64x36 grey copy only)
#   --live       lines come out at the video's own pace (a bot watching along); default: as fast as the box can go
#   --focus T    the zoom in, after the zoomed-out first run: 15 s either side of T with the better speech model, voices
#                matched to the first run's (same numbers), and a look every second at the part of the picture that moves
#   --detail quick|full  how much the bot wants: quick = a first idea fast (only new-looking scenes described, a smaller picture
#                for the vision model); full (default) = every scene at the model's full size, a long run
#   --describe   a line from the local vision model (Ollama, PERCH_MODEL, default gemma-chuck) at each cut: local, no tokens
# Pictures for the bot only on request: perch-video --frame T FILE -> "pixels FILE wxh ~T tokens" (one frame, small).
# Not yet: speech (a local Whisper), motion vectors from the codec itself.
import json, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [HERE, "/usr/lib/perch"]
# a session a bot drives while the video plays (perch_play.py): perch-video NAME play FILE | read | back N | set ... | seek | ...
if len(sys.argv) >= 3 and re.fullmatch(r"[a-z0-9-]{1,40}", sys.argv[1]) and sys.argv[2] in (
        "--serve", "play", "read", "back", "set", "seek", "pause", "go", "status", "lessons", "summary", "stop"):
    import perch_play
    if sys.argv[2] == "--serve": perch_play.serve(HERE, sys.argv[1], sys.argv[3:]); sys.exit(0)
    perch_play.client(HERE, sys.argv[1], sys.argv[2:])
USAGE = "usage: perch-video [--fps N] [--live] [--describe] [--from T] [--to T] FILE|URL   |   perch-video --frame T FILE|URL"
GW, GH = 64, 36                                   # the grey copy the scene/motion pass looks at: numbers, never shown
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "perch-video"); os.makedirs(RUN, mode=0o700, exist_ok=True)

def ts(t):
    m, s = divmod(round(max(0.0, t), 1), 60); h, m = divmod(int(m), 60)          # rounded first: never "0:60.0"
    return (f"{h}:{m:02d}:{s:04.1f}" if h else f"{m}:{s:04.1f}")

def secs(v):
    p = [float(x) for x in str(v).split(":")]
    return sum(x * 60 ** i for i, x in enumerate(reversed(p)))

def q(t, n=300):
    t = re.sub(r"\s+", " ", str(t or "")).strip()[:n]
    return "'" + t.replace("\\", "\\\\").replace("'", "\\'") + "'"


def ask_summary(words, room=12000):
    """the local model's short best guess at what a video is about, from its words; a long video is sent as even slices from
    start to end (not just its first minutes). -> (summary or None, why not or None)"""
    import urllib.request
    words = words.strip()
    if len(words) > room:
        n = 12; step = len(words) / n; part = room // n - 8
        words = " … ".join(words[int(i * step): int(i * step) + part] for i in range(n))
    ask = ("Below is what a speech-to-text tool, a screen reader, a sound namer ([sound T: name]) and a scene describer ([scene: ...]) "
           "made of a video: best guesses, maybe wrong in places. A long video "
           "comes as slices from start to end, joined by '…'. In 2 or 3 short sentences say what the video is and what happens in it, "
           "from start to end (the video itself, not how these notes look). "
           "Start with 'I think' and say plainly where you are unsure. Do not guess anyone's sex: say they or the speaker unless a "
           "name is given.\n\n" + words)
    try:
        body = json.dumps({"model": os.environ.get("PERCH_MODEL", "gemma-chuck"), "stream": False, "keep_alive": "10m", "think": False,
                           "messages": [{"role": "user", "content": ask}]}).encode()
        r_ = json.load(urllib.request.urlopen(urllib.request.Request(os.environ.get("PERCH_OLLAMA", "http://127.0.0.1:11434") + "/api/chat", body), timeout=900))
        out = re.sub(r"\s+", " ", r_.get("message", {}).get("content", "")).strip() or None
    except Exception as e:
        return None, type(e).__name__
    if out and len(out) > 900:                                  # long: kept to whole sentences, never cut mid-word
        out = out[:900]; out = out[:max(out.rfind(". "), out.rfind("? "), out.rfind("! ")) + 1] or out
    return out, None


def summary_words(rows):
    """what the summary is made from, in time order: words said and shown, and for a video with few words also what each scene
    looked like (see lines) and the named sounds (music and speech left out; a sound is named again only after a change)"""
    out, last = [], None
    for t_, _, l_ in sorted(rows, key=lambda e: (e[0], e[1])):
        if l_.startswith(("say ", "sub ", "text ")):
            out.append(re.sub(r"^\S+ \S+ (?:sure \d+ )?", "", l_).strip("'"))
        elif l_.startswith("see "):
            out.append("[scene: " + re.sub(r"^see \S+ ", "", l_).strip("'") + "]")
        elif l_.startswith("sound "):
            m_ = re.match(r"sound (\S+)-\S+ (?:sure (\d+) )?'([^']+)'", l_)
            if m_ and m_.group(3) not in ("Music", "Speech", last) and int(m_.group(2) or 11) >= 6:
                out.append(f"[sound {m_.group(1).split('.')[0]}: {m_.group(3)}]"); last = m_.group(3)
    return " ".join(out)

STAGES, _clock = {}, [time.time()]
def stage(name):                                                # the time since the last mark goes to this part of the work
    now = time.time(); STAGES[name] = STAGES.get(name, 0) + now - _clock[0]; _clock[0] = now
args, opt = sys.argv[1:], {"fps": 4.0, "live": False, "describe": False, "from": 0.0, "to": None, "frame": None}
src = None
try:
    while args:
        a = args.pop(0)
        if a == "--fps": opt["fps"] = float(args.pop(0)); assert 0.2 <= opt["fps"] <= 30
        elif a == "--live": opt["live"] = True
        elif a == "--describe": opt["describe"] = True
        elif a == "--no-voices": opt["novoices"] = True
        elif a == "--focus": opt["focus"] = secs(args.pop(0))
        elif a == "--detail": opt["detail"] = args.pop(0); assert opt["detail"] in ("quick", "full")
        elif a == "--no-sound": opt["nosound"] = True
        elif a == "--speech": opt["speech"] = True
        elif a == "--summary": opt["summary"] = True
        elif a == "--hint": opt["hint"] = args.pop(0); assert re.fullmatch(r"[a-z]{2,3}", opt["hint"])
        elif a == "--lang": opt["lang"] = args.pop(0); assert re.fullmatch(r"auto|[a-z]{2,3}", opt["lang"])
        elif a == "--quality": opt["quality"] = args.pop(0); assert opt["quality"] in ("tiny", "base", "small", "medium", "large-v3")
        elif a == "--scenes": opt["scenes"] = True
        elif a in ("--pack", "--unpack", "--spoiler"): opt[a[2:]] = args.pop(0)
        elif a == "--seen": opt["seen"] = args.pop(0) if args and not args[0].startswith("-") else ""
        elif a in ("--from", "--to", "--frame"): opt[a[2:]] = secs(args.pop(0))
        elif a.startswith("-"): raise ValueError
        elif src is None: src = a
        else: raise ValueError
except (ValueError, IndexError, AssertionError):
    sys.exit(USAGE)
if opt.get("focus") is not None:                                # the zoom in: the first run is the zoomed-out view of the whole video
    f_ = opt["focus"]
    opt["from"] = max(0.0, f_ - 15) if opt["from"] == 0.0 else opt["from"]
    opt["to"] = (f_ + 15) if opt["to"] is None else opt["to"]
    opt.setdefault("quality", "small"); opt["describe"] = True; opt["detail"] = "full"
if opt.get("unpack"):
    import gzip
    try: sys.stdout.write(gzip.open(opt["unpack"], "rt", encoding="utf-8").read()); sys.exit(0)
    except (OSError, EOFError): sys.exit("err not a perch-video pack")
# ---------- kept: what a video taught, one small file per video on this machine (never the footage) ----------
# ~/.local/share/perch/videos/KEY.gz: line 1 the lessons (json), then the lines with their times. Shown again with --seen KEY
# even when the video itself is gone. No spoilers: a bot is told it saw the video before and what it was about, but the summary
# only when it asks (--spoiler KEY, or the session's "summary").
KEPT = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "perch", "videos")
def video_key(p):
    import hashlib
    h = hashlib.sha256()
    try:
        with open(p, "rb") as f: h.update(f.read(1 << 20))
        h.update(str(os.path.getsize(p)).encode())
    except OSError:
        h.update(p.encode())                                    # an address: the address itself
    return h.hexdigest()[:24]
def kept_load(k):
    import gzip
    try:
        with gzip.open(os.path.join(KEPT, k + ".gz"), "rt", encoding="utf-8") as f:
            meta = json.loads(f.readline()); rows = []
            for l in f:
                t_, p_, l_ = l.rstrip("\n").split("\t", 2); rows.append((float(t_), int(p_), l_))
            return meta, rows
    except (OSError, ValueError, EOFError):
        return {}, []
def kept_save(k, meta, rows):
    import gzip
    os.makedirs(KEPT, mode=0o700, exist_ok=True)
    old = os.umask(0o077)
    with gzip.open(os.path.join(KEPT, k + ".gz.new"), "wt", encoding="utf-8") as f:
        f.write(json.dumps(meta, ensure_ascii=False) + "\n")
        for t_, p_, l_ in sorted(rows, key=lambda e: (e[0], e[1])): f.write(f"{t_:.2f}\t{p_}\t{l_}\n")
    os.umask(old); os.replace(os.path.join(KEPT, k + ".gz.new"), os.path.join(KEPT, k + ".gz"))
def kept_migrate():                                             # the old one-file store (video-lessons.json) moved over once
    oldf = os.path.join(os.path.dirname(KEPT), "video-lessons.json")
    try: allv = json.load(open(oldf))
    except (OSError, ValueError): return
    for k_, m_ in allv.items():
        if not os.path.exists(os.path.join(KEPT, k_ + ".gz")): kept_save(k_, m_, [])
    os.remove(oldf)
kept_migrate()
def kept_key(x):                                                # a file, an address, or a KEY from --seen
    if re.fullmatch(r"[0-9a-f]{24}", x or ""): return x
    if x and (os.path.isfile(x) or re.match(r"^https?://\S+$", x)): return video_key(x)
    sys.exit(f"err no such video or key: {x}")
if opt.get("seen") is not None or opt.get("spoiler"):
    if opt.get("spoiler"):
        meta, _ = kept_load(kept_key(opt["spoiler"]))
        if not meta: sys.exit("err not seen before")
        print(f"summary (the local model, a best guess, made {meta.get('seen', '?')}): {q(meta['summary'], 900)}" if meta.get("summary")
              else "! no summary kept for it (perch-video --summary FILE makes one)"); sys.exit(0)
    if opt["seen"] == "":                                       # every video seen, newest first
        got = []
        for f_ in os.listdir(KEPT) if os.path.isdir(KEPT) else []:
            if f_.endswith(".gz"):
                m_, r_ = kept_load(f_[:-3]); got.append((m_.get("seen", ""), f_[:-3], m_, len(r_)))
        for when, k_, m_, n_ in sorted(got, reverse=True):
            print(f"seen {k_} {when or '?'} {q(m_.get('name', '?'))} {n_} lines" + (f" about: {m_['about']}" if m_.get("about") else "") +
                  (" · summary kept" if m_.get("summary") else ""))
        if not got: print("! no videos seen yet")
        sys.exit(0)
    k_ = kept_key(opt["seen"]); meta, rows = kept_load(k_)
    if not meta: sys.exit("err not seen before")
    if opt.get("summary"):                                      # a new summary from what was kept, no need to watch again
        said = summary_words(rows)
        if not said.strip(): sys.exit("err no words kept for it")
        sm, why = ask_summary(said)
        if not sm: sys.exit(f"err summary not made: {why}")
        meta["summary"] = sm; kept_save(k_, meta, rows)
        print(f"summary (the local model, a best guess, made now from the kept lines): {q(sm, 900)}"); sys.exit(0)
    print(f"! kept {k_}: {q(meta.get('name', '?'))} seen {meta.get('seen', '?')}" + (f", lang {meta['lang']}" if meta.get("lang") else "") +
          (f", lines of {meta['span']}" if meta.get("span") else ", no lines kept") + (" · a summary is kept: --spoiler " + k_ if meta.get("summary") else ""))
    if meta.get("head"): print(meta["head"])
    for _, _, l_ in sorted(rows, key=lambda e: (e[0], e[1])): print(l_)
    for l_ in meta.get("lessons", []): print(l_)
    sys.exit(0)
if not src: sys.exit(USAGE)
if not (re.match(r"^https?://\S+$", src) or os.path.isfile(src)): sys.exit(f"err no such file: {src}")
FF = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin"]

# ---------- one frame, only when asked ----------
if opt["frame"] is not None:
    out = os.path.join(RUN, "frame.png")
    r = subprocess.run(FF + ["-ss", str(opt["frame"]), "-i", src, "-frames:v", "1", "-vf", "scale='min(640,iw)':-2", "-y", out], capture_output=True)
    if r.returncode or not os.path.exists(out): sys.exit("err no frame there")
    from PIL import Image
    w, h = Image.open(out).size
    print(f"pixels {out} {w}x{h} ~{w * h // 750} tokens"); sys.exit(0)

# ---------- the video itself: its own information ----------
try:
    info = json.loads(subprocess.run(["ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams", "-show_chapters", src],
                                     capture_output=True, text=True, timeout=60).stdout or "{}")
except (subprocess.TimeoutExpired, ValueError):
    info = {}
streams = info.get("streams", [])
v = next((s for s in streams if s.get("codec_type") == "video" and not s.get("disposition", {}).get("attached_pic")), None)
if not v: sys.exit("err no video in it (or it cannot be read)")
dur = float(info.get("format", {}).get("duration") or v.get("duration") or 0)
num, _, den = (v.get("avg_frame_rate") or "0/1").partition("/"); fps = float(num) / float(den or 1) if float(den or 1) else 0
title = (info.get("format", {}).get("tags", {}) or {}).get("title") or os.path.basename(src.split("?")[0])
subs = [s for s in streams if s.get("codec_type") == "subtitle"]
textsubs = [s for s in subs if s.get("codec_name") in ("subrip", "ass", "ssa", "mov_text", "webvtt", "text")]
langs = ",".join(sorted({(s.get("tags") or {}).get("language", "und") for s in textsubs}))
sound = any(s.get("codec_type") == "audio" for s in streams)
lines = []                                       # (time, order, text): merged and sorted at the end (or paced, --live)
def video_date():
    tags = {**(info.get("format", {}).get("tags") or {}), **(v.get("tags") or {})}
    for k in ("date", "DATE"):
        m = re.match(r"(\d{4})-(\d{2})-(\d{2})", str(tags.get(k, "")))
        if m and m.group(1) > "1900" and not str(tags.get(k, "")).startswith("1970"):
            return f"{m.group(0)} (from its {'own date' if k != 'creation_time' else 'file: when it was made or copied, maybe not when it was said'})"
    name = os.path.basename(src.split("?")[0]) + " " + title
    m = re.search(r"(?<!\d)(\d{1,2})[._-](\d{1,2})[._-]((?:19|20)\d{2})(?!\d)", name)
    if m and 1 <= int(m.group(1)) <= 31 and 1 <= int(m.group(2)) <= 12:
        return f"{m.group(3)}-{int(m.group(2)):02d}-{int(m.group(1)):02d} (from its name)"
    m = re.search(r"(?<!\d)((?:19|20)\d{2})[._-](\d{1,2})[._-](\d{1,2})(?!\d)", name)
    if m: return f"{m.group(1)}-{int(m.group(2)):02d}-{int(m.group(3)):02d} (from its name)"
    m = re.search(r"(?<!\d)((?:19[5-9]|20[0-4])\d)(?!\d)", name)
    if m: return f"around {m.group(1)} (a year in its name)"
    for k in ("creation_time", "com.apple.quicktime.creationdate"):
        m = re.match(r"(\d{4})-(\d{2})-(\d{2})", str(tags.get(k, "")))
        if m and m.group(1) > "1900" and not str(tags.get(k, "")).startswith("1970"):
            return f"{m.group(0)} (the file's: when it was made or copied, maybe not when it was said)"
    return None
when = video_date()
head = f"V {q(title)} {ts(dur)} {v.get('width')}x{v.get('height')} {fps:.4g}fps" + (" sound" if sound else "") + (f" subs:{langs}" if textsubs else "") + (f" date {when}" if when else "")
for c in info.get("chapters", []):
    lines.append((float(c.get("start_time", 0)), 0, f"ch {ts(float(c.get('start_time', 0)))} {q((c.get('tags') or {}).get('title', ''))}"))

# ---------- the words the video carries: its subtitle tracks ----------
def srt(text):
    for block in re.split(r"\n\s*\n", text.replace("\r", "")):
        m = re.search(r"(\d+):(\d+):(\d+)[,.](\d+)\s*-->\s*(\d+):(\d+):(\d+)[,.](\d+)\s*\n(.*)", block, re.S)
        if m:
            g = [int(x) for x in m.groups()[:8]]
            yield g[0] * 3600 + g[1] * 60 + g[2] + g[3] / 1000, re.sub(r"<[^>]+>|\{[^}]*\}", "", m.group(9)).strip()
if textsubs:
    s0 = textsubs[0]                               # the first text track (its language is in the V line)
    r = subprocess.run(FF + ["-i", src, "-map", f"0:{s0['index']}", "-f", "srt", "-"], capture_output=True, text=True, timeout=300)
    for t, words in srt(r.stdout):
        if words: lines.append((t, 1, f"sub {ts(t)} {q(words)}"))
elif subs:
    lines.append((0, 1, "! subtitles are pictures (not text) in this file: not read"))

stage("start, subtitles")
# ---------- frames for reading words and describing: read 6 at a time, described one at a time, as soon as each is chosen ----------
def frame_at(t):                                                # one frame by seeking (a stream, or no single pass)
    out = os.path.join(RUN, f"scene-{t:.2f}.png")
    r = subprocess.run(FF + ["-ss", f"{t + 0.15:.3f}", "-i", src, "-frames:v", "1", "-y", out], capture_output=True)
    if r.returncode or not os.path.exists(out): return None
    from PIL import Image
    im = Image.open(out); im.load(); os.remove(out)
    return im.convert("RGB")


def see_line(t, im, box=None):                                  # one line from the local vision model about one frame (or a zoomed part)
    import base64, io, urllib.request
    ask = "Say in one short line what this video frame shows. No preamble."
    if box:                                                     # zoomed: the part of the picture where something moves, at full detail
        im = im.crop(box)
        ask = ("This is a zoomed-in part of a video frame. In one short line say who or what is there, and whether anyone in it "
               "seems to be speaking (mouth open, mid-word). No preamble. Do not guess anyone's sex.")
    im = im.copy(); im.thumbnail((448, 448) if opt.get("detail") == "quick" else (896, 896))   # full: the model's own input size
    buf = io.BytesIO(); im.save(buf, "PNG")
    body = json.dumps({"model": os.environ.get("PERCH_MODEL", "gemma-chuck"), "stream": False, "keep_alive": "10m", "think": False,
                       "messages": [{"role": "user", "content": ask,
                                     "images": [base64.b64encode(buf.getvalue()).decode()]}]}).encode()
    a = json.load(urllib.request.urlopen(urllib.request.Request(os.environ.get("PERCH_OLLAMA", "http://127.0.0.1:11434") + "/api/chat", body), timeout=300))
    where = f" zoom {box[0]},{box[1]},{box[2] - box[0]}x{box[3] - box[1]}" if box else ""
    return (t, 5, f"see {ts(t)}{where} {q(a.get('message', {}).get('content', ''))}")


