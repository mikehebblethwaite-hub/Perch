    zooming = opt.get("focus") is not None and abs(t - opt["focus"]) <= 5.01
    read = (t >= (reads[-1] if reads else -9) + (1.0 if zooming else 2.0) and (changed or zooming)) or j == 0 or bool(is_cut)
    if read:
        reads.append(t); last_read = fr
