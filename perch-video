# ---------- at each scene: the words on the screen (read here) and, if asked, one line from the local model ----------
def frame_at(t):
    out = os.path.join(RUN, "scene.png")
    r = subprocess.run(FF + ["-ss", f"{t + 0.15:.3f}", "-i", src, "-frames:v", "1", "-y", out], capture_output=True)
    return out if not r.returncode and os.path.exists(out) else None
try:
    import perch_read as reader
except ImportError:
    reader = None
seen_text = set()
for i, t in enumerate(sorted(set([opt["from"]] + cuts + reads))):
    f = frame_at(t)
    if not f: continue
    if reader and reader.available():
        from PIL import Image
        im = Image.open(f); im.load()
        for x, y, w, h, words in reader.read(im, [(0, 0, im.width, im.height)], page=True):
            real = [w_ for w_ in re.findall(r"[A-Za-z\u00c0-\u024f]{3,}", words) if re.search(r"[aeiouyAEIOUY]", w_)]
            if (any(len(w_) >= 4 for w_ in real) or len(real) >= 2) and words not in seen_text:   # junk like 'Bf', '= ul' left out
                lines.append((t, 4, f"text {ts(t)} {q(words)}")); seen_text.add(words)
    if opt["describe"] and (t in cuts or t == opt["from"]):
        import base64, urllib.request
        body = json.dumps({"model": os.environ.get("PERCH_MODEL", "gemma-chuck"), "stream": False, "keep_alive": "10m",
                           "messages": [{"role": "user", "content": "Say in one short line what this video frame shows. No preamble.",
                                         "images": [base64.b64encode(open(f, "rb").read()).decode()]}]}).encode()
        try:
            a = json.load(urllib.request.urlopen(urllib.request.Request(os.environ.get("PERCH_OLLAMA", "http://127.0.0.1:11434") + "/api/chat", body), timeout=300))
            lines.append((t, 5, f"see {ts(t)} {q(a.get('message', {}).get('content', ''))}"))
        except Exception as e:
            lines.append((t, 5, f"! no description at {ts(t)}: {type(e).__name__}")); opt["describe"] = False

# ---------- out: sorted by time; --live: at the video's own pace ----------
lines = [e for e in lines if not (e[0] < opt["from"] - 0.01 or (opt["to"] is not None and e[0] > opt["to"]))]
# where a sound is named (the tagger), the rough s lines add nothing: they stay only for stretches nothing named
named = [tuple(map(secs, re.match(r"sound (\S+)-(\S+) ", l).groups())) for _, k, l in lines if l.startswith("sound ")]   # 'sound T0-T1 sure N ...' 
lines = [e for e in lines if not (e[2].startswith("s ") and any(a - 0.05 <= e[0] <= b for a, b in named))]
if opt.get("scenes"):                                   # one line per scene, everything that happens in it
    edges = [opt["from"]] + cuts + [opt["to"] if opt["to"] is not None else dur]
    out = [head]
    for i, (a, b) in enumerate(zip(edges, edges[1:]), 1):
        inside = sorted((e for e in lines if a - 0.01 <= e[0] < b - 0.01 or (i == len(edges) - 1 and e[0] >= a - 0.01)), key=lambda e: (e[0], e[1]))
        parts, sounds = [], []
        for t, kind, l in inside:
            w = l.split(" ", 2)
            if w[0] in ("text", "see"): parts.append(f"{w[0]} {w[2]}")
            elif w[0] == "sub": parts.append(f"sub {w[1]} {w[2]}")
            elif w[0] == "say": parts.append(f"say {w[1]} {w[2]}")                     # w[2] = "sure N 'words'"
            elif w[0] == "sound":
                m = re.match(r"sound (\S+)-(\S+) sure (\d+) ('(?:[^'\\]|\\.)*')", l)
                if m: sounds.append((m.group(1), f"{m.group(4).strip(chr(39))} (sure {m.group(3)})", None, m.group(2)))
            elif w[0] == "ch": parts.append(f"chapter {w[2]}")
            elif w[0] == "moves": parts.append(f"moves {w[2]} ({w[1]})")
            elif w[0] == "s":
                m = re.match(r"s (\S+) L(\d+) (tone \d+Hz|\S+)", l)
                if m and m.group(3) != "quiet": sounds.append((m.group(1), m.group(3), m.group(2)))
        if sounds:                                       # a run of tones becomes one: tones 520/660/780Hz from 0:09.2
            sd, k = [], 0
            while k < len(sounds):
                j = k
                while j + 1 < len(sounds) and sounds[j + 1][1].startswith("tone") and sounds[k][1].startswith("tone"): j += 1
                if j > k: sd.append(f"tones {'/'.join(x[1].split()[1][:-2] for x in sounds[k:j + 1])}Hz {sounds[k][0]}")
                elif sounds[k][2] is None: sd.append(f"{sounds[k][1]} {sounds[k][0]}-{sounds[k][3]}")      # a named sound and its span
                else: sd.append(f"{sounds[k][1]} {sounds[k][0]} L{sounds[k][2]}")
                k = j + 1
            parts.append("sound " + ", ".join(sd))
        out.append(f"{i} {ts(a)}-{ts(b)} " + " · ".join(parts) if parts else f"{i} {ts(a)}-{ts(b)} (nothing read)")
    text_out = "\n".join(out) + "\n"
else:
