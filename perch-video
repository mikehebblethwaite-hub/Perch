#!/usr/bin/python3 -I
# Copyright (c) 2026 Mike J Hebblethwaite. See LICENSE.md.
# perch-video 0.01: a video player for bots. A video is played the bot's way: not pictures at x frames a second but what the
# video carries as information, earliest first, as short timed lines (only what changed):
#   V 'title' 1:30 1280x720 25fps sound subs:en      the video itself (one line)
#   ch 0:00.0 'Introduction'                          a chapter, from the file
#   sub 0:01.2 'Welcome to the course'                the subtitle/caption track: the exact words, with times
#   cut 0:03.0 2                                      a new scene (shot 2): the picture changed all at once
#   text 0:03.0 'Step 1: turn off the gas'            words on the screen at a cut (slides, signs), read here (no tokens)
#   see 0:03.0 'a man pointing at a boiler'           with --describe: one line from the local vision model at each cut
#   say 0:01.2 sure 9 'ask not what ...'              speech as words (how sure, 1-11, from the speech model's own word confidence)
#                                                     A guess, like half a phone call: pass it on as "I think they said '...'
#                                                     (I cannot be 100% sure)", "it sounded like '...'" when sure is low,
#                                                     with the date when known ("in a speech on 2016-11-30", "around 2016")
#   (old form) say 0:01.2 'ask not what your country...' speech as words (Whisper, here on the machine), when it has no subtitles
#                                                     (or always with --speech); the V line names the language it heard
#   sound 0:03.2-0:05.0 sure 9 'Dog'                  a sound named (YAMNet, 521 kinds, here on the machine), how sure 1-11:
#                                                     pass it on as "it sounded like a dog" (never "there was a dog")
#   s 0:03.2 L7 tone 440Hz b 2-9-3-1-1                its sound, when it changes (perch_sound.py): loudness 1-11, quiet/tone/
#                                                     voice?/music?/noise/bang, five bands 1-11 (low..high); --no-sound: none
#   moves 0:04.2-0:07.9 bottom-left > bottom-right    something moved, from where to where (a 3x3 grid), in one line
#   ! ...                                             what happened (no subtitles, cannot read the file ...)
#   --scenes     the whole video at a glance: one line per scene with everything in it (words, subtitles, movement, sounds)
#   --pack OUT   the lines zipped into OUT (to keep or send); perch-video --unpack OUT gives them back to read (a bot reads
#                the lines, never the zipped bytes: encoded data costs a bot more, not less)
#   --summary    a lesson line from the local model (Ollama, PERCH_MODEL) saying what the video seems to be about, as a best guess
#   --hint L     try this language first when guessing (it is still checked; the session passes on what a piece needed)
#   --lang L     the speech's language (en, cy, fr ...; default auto)   --quality Q  base (default) | small (better, slower) | ...
# A session a bot drives as it plays (adjust, replay, go on): perch-video NAME play FILE, then read / back N / set lang|quality|speech V /
#   seek T / pause / go / status / stop (perch_play.py)
# Usage: perch-video [--fps N] [--live] [--describe] [--scenes] [--pack OUT] [--lang L] [--quality Q] [--from T] [--to T] FILE|URL
#   --fps N      how often motion is checked (default 4 a second; the scene/motion pass sees a 64x36 grey copy only)
#   --live       lines come out at the video's own pace (a bot watching along); default: as fast as the box can go
#   --describe   a line from the local vision model (Ollama, PERCH_MODEL, default gemma-chuck) at each cut: local, no tokens
# Pictures for the bot only on request: perch-video --frame T FILE -> "pixels FILE wxh ~T tokens" (one frame, small).
# Not yet: speech (a local Whisper), motion vectors from the codec itself.
import json, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [HERE, "/usr/lib/perch"]
# a session a bot drives while the video plays (perch_play.py): perch-video NAME play FILE | read | back N | set ... | seek | ...
if len(sys.argv) >= 3 and re.fullmatch(r"[a-z0-9-]{1,40}", sys.argv[1]) and sys.argv[2] in (
        "--serve", "play", "read", "back", "set", "seek", "pause", "go", "status", "lessons", "stop"):
    import perch_play
    if sys.argv[2] == "--serve": perch_play.serve(HERE, sys.argv[1], sys.argv[3:]); sys.exit(0)
    perch_play.client(HERE, sys.argv[1], sys.argv[2:])
USAGE = "usage: perch-video [--fps N] [--live] [--describe] [--from T] [--to T] FILE|URL   |   perch-video --frame T FILE|URL"
GW, GH = 64, 36                                   # the grey copy the scene/motion pass looks at: numbers, never shown
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "perch-video"); os.makedirs(RUN, mode=0o700, exist_ok=True)

def ts(t):
    m, s = divmod(round(max(0.0, t), 1), 60); h, m = divmod(int(m), 60)          # rounded first: never "0:60.0"
    return (f"{h}:{m:02d}:{s:04.1f}" if h else f"{m}:{s:04.1f}")

def secs(v):
    p = [float(x) for x in str(v).split(":")]
    return sum(x * 60 ** i for i, x in enumerate(reversed(p)))

def q(t):
    t = re.sub(r"\s+", " ", str(t or "")).strip()[:300]
    return "'" + t.replace("\\", "\\\\").replace("'", "\\'") + "'"

args, opt = sys.argv[1:], {"fps": 4.0, "live": False, "describe": False, "from": 0.0, "to": None, "frame": None}
src = None
try:
    while args:
        a = args.pop(0)
        if a == "--fps": opt["fps"] = float(args.pop(0)); assert 0.2 <= opt["fps"] <= 30
        elif a == "--live": opt["live"] = True
        elif a == "--describe": opt["describe"] = True
        elif a == "--no-sound": opt["nosound"] = True
        elif a == "--speech": opt["speech"] = True
        elif a == "--summary": opt["summary"] = True
        elif a == "--hint": opt["hint"] = args.pop(0); assert re.fullmatch(r"[a-z]{2,3}", opt["hint"])
        elif a == "--lang": opt["lang"] = args.pop(0); assert re.fullmatch(r"auto|[a-z]{2,3}", opt["lang"])
        elif a == "--quality": opt["quality"] = args.pop(0); assert opt["quality"] in ("tiny", "base", "small", "medium", "large-v3")
        elif a == "--scenes": opt["scenes"] = True
        elif a in ("--pack", "--unpack"): opt[a[2:]] = args.pop(0)
        elif a in ("--from", "--to", "--frame"): opt[a[2:]] = secs(args.pop(0))
        elif a.startswith("-"): raise ValueError
        elif src is None: src = a
        else: raise ValueError
except (ValueError, IndexError, AssertionError):
    sys.exit(USAGE)
if opt.get("unpack"):
    import gzip
    try: sys.stdout.write(gzip.open(opt["unpack"], "rt", encoding="utf-8").read()); sys.exit(0)
    except (OSError, EOFError): sys.exit("err not a perch-video pack")
if not src: sys.exit(USAGE)
if not (re.match(r"^https?://\S+$", src) or os.path.isfile(src)): sys.exit(f"err no such file: {src}")
FF = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin"]

# ---------- one frame, only when asked ----------
if opt["frame"] is not None:
    out = os.path.join(RUN, "frame.png")
    r = subprocess.run(FF + ["-ss", str(opt["frame"]), "-i", src, "-frames:v", "1", "-vf", "scale='min(640,iw)':-2", "-y", out], capture_output=True)
    if r.returncode or not os.path.exists(out): sys.exit("err no frame there")
    from PIL import Image
    w, h = Image.open(out).size
    print(f"pixels {out} {w}x{h} ~{w * h // 750} tokens"); sys.exit(0)

# ---------- the video itself: its own information ----------
try:
    info = json.loads(subprocess.run(["ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams", "-show_chapters", src],
                                     capture_output=True, text=True, timeout=60).stdout or "{}")
except (subprocess.TimeoutExpired, ValueError):
    info = {}
streams = info.get("streams", [])
v = next((s for s in streams if s.get("codec_type") == "video" and not s.get("disposition", {}).get("attached_pic")), None)
if not v: sys.exit("err no video in it (or it cannot be read)")
dur = float(info.get("format", {}).get("duration") or v.get("duration") or 0)
num, _, den = (v.get("avg_frame_rate") or "0/1").partition("/"); fps = float(num) / float(den or 1) if float(den or 1) else 0
title = (info.get("format", {}).get("tags", {}) or {}).get("title") or os.path.basename(src.split("?")[0])
subs = [s for s in streams if s.get("codec_type") == "subtitle"]
textsubs = [s for s in subs if s.get("codec_name") in ("subrip", "ass", "ssa", "mov_text", "webvtt", "text")]
langs = ",".join(sorted({(s.get("tags") or {}).get("language", "und") for s in textsubs}))
sound = any(s.get("codec_type") == "audio" for s in streams)
lines = []                                       # (time, order, text): merged and sorted at the end (or paced, --live)
def video_date():
    tags = {**(info.get("format", {}).get("tags") or {}), **(v.get("tags") or {})}
    for k in ("date", "DATE"):
        m = re.match(r"(\d{4})-(\d{2})-(\d{2})", str(tags.get(k, "")))
        if m and m.group(1) > "1900" and not str(tags.get(k, "")).startswith("1970"):
            return f"{m.group(0)} (from its {'own date' if k != 'creation_time' else 'file: when it was made or copied, maybe not when it was said'})"
    name = os.path.basename(src.split("?")[0]) + " " + title
    m = re.search(r"(?<!\d)(\d{1,2})[._-](\d{1,2})[._-]((?:19|20)\d{2})(?!\d)", name)
    if m and 1 <= int(m.group(1)) <= 31 and 1 <= int(m.group(2)) <= 12:
        return f"{m.group(3)}-{int(m.group(2)):02d}-{int(m.group(1)):02d} (from its name)"
    m = re.search(r"(?<!\d)((?:19|20)\d{2})[._-](\d{1,2})[._-](\d{1,2})(?!\d)", name)
    if m: return f"{m.group(1)}-{int(m.group(2)):02d}-{int(m.group(3)):02d} (from its name)"
    m = re.search(r"(?<!\d)((?:19[5-9]|20[0-4])\d)(?!\d)", name)
    if m: return f"around {m.group(1)} (a year in its name)"
    for k in ("creation_time", "com.apple.quicktime.creationdate"):
        m = re.match(r"(\d{4})-(\d{2})-(\d{2})", str(tags.get(k, "")))
        if m and m.group(1) > "1900" and not str(tags.get(k, "")).startswith("1970"):
            return f"{m.group(0)} (the file's: when it was made or copied, maybe not when it was said)"
    return None
when = video_date()
head = f"V {q(title)} {ts(dur)} {v.get('width')}x{v.get('height')} {fps:.4g}fps" + (" sound" if sound else "") + (f" subs:{langs}" if textsubs else "") + (f" date {when}" if when else "")
for c in info.get("chapters", []):
    lines.append((float(c.get("start_time", 0)), 0, f"ch {ts(float(c.get('start_time', 0)))} {q((c.get('tags') or {}).get('title', ''))}"))

# ---------- the words the video carries: its subtitle tracks ----------
def srt(text):
    for block in re.split(r"\n\s*\n", text.replace("\r", "")):
        m = re.search(r"(\d+):(\d+):(\d+)[,.](\d+)\s*-->\s*(\d+):(\d+):(\d+)[,.](\d+)\s*\n(.*)", block, re.S)
        if m:
            g = [int(x) for x in m.groups()[:8]]
            yield g[0] * 3600 + g[1] * 60 + g[2] + g[3] / 1000, re.sub(r"<[^>]+>|\{[^}]*\}", "", m.group(9)).strip()
if textsubs:
    s0 = textsubs[0]                               # the first text track (its language is in the V line)
    r = subprocess.run(FF + ["-i", src, "-map", f"0:{s0['index']}", "-f", "srt", "-"], capture_output=True, text=True, timeout=300)
    for t, words in srt(r.stdout):
        if words: lines.append((t, 1, f"sub {ts(t)} {q(words)}"))
elif subs:
    lines.append((0, 1, "! subtitles are pictures (not text) in this file: not read"))

# ---------- scenes and movement: a 64x36 grey copy, as numbers ----------
cuts = []
def grid_name(i):
    return ("top", "middle", "bottom")[i // 3] + "-" + ("left", "centre", "right")[i % 3] if i != 4 else "centre"
cmd = FF + (["-ss", str(opt["from"])] if opt["from"] else []) + ["-i", src] + (["-t", str(opt["to"] - opt["from"])] if opt["to"] else []) + \
      ["-an", "-sn", "-vf", f"fps={opt['fps']},scale={GW}:{GH},format=gray", "-f", "rawvideo", "-"]
p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
prev, k, seg = None, 0, None
reads, last_read = [], None                         # when to read the words on screen: cuts, and every 2 s if the picture changed                       # seg: a run of movement [start, first cells' centre, last centre, end]
def centre(cells):
    return (sum(i % 3 for i in cells) / len(cells), sum(i // 3 for i in cells) / len(cells))
def place(c):
    i = round(c[1]) * 3 + round(c[0]); return grid_name(i)
def end_seg(t):
    global seg
    if seg:
        a, b = place(seg[1]), place(seg[2])
        lines.append((seg[0], 3, f"moves {ts(seg[0])}-{ts(t)} {a}" + (f" > {b}" if b != a else "")))
    seg = None
size = GW * GH
while True:
    fr = p.stdout.read(size)
    if len(fr) < size: break
    t = opt["from"] + k / opt["fps"]; k += 1
    if prev is not None:
        d = [abs(a - b) for a, b in zip(fr, prev)]
        whole = sum(d) / size
        ha = [0] * 16; hb = [0] * 16
        for a_, b_ in zip(fr, prev): ha[a_ >> 4] += 1; hb[b_ >> 4] += 1
        mix = sum(abs(a_ - b_) for a_, b_ in zip(ha, hb)) / (2 * size)         # 0 = the same light and dark, 1 = all different
        if whole > 28 and mix > 0.35:                   # the picture changed at once, and what is in it: a new scene (a pan keeps the mix)
            end_seg(t); cuts.append(t); lines.append((t, 2, f"cut {ts(t)} {len(cuts) + 1}"))
        else:
            cells = []
            for i in range(9):
                cx, cy = i % 3, i // 3
                cd = [d[y * GW + x] for y in range(cy * GH // 3, (cy + 1) * GH // 3) for x in range(cx * GW // 3, (cx + 1) * GW // 3)]
                if sum(1 for x in cd if x > 18) > len(cd) * 0.04: cells.append(i)
            if cells:
                c = centre(cells)
                if seg is None: seg = [t, c, c, t]
                else: seg[2] = c; seg[3] = t
            elif seg and t - seg[3] > 0.6: end_seg(seg[3] + 1 / opt["fps"])    # still for a moment: that movement is over
    if t >= (reads[-1] if reads else -9) + 2.0 and (last_read is None or sum(abs(a_ - b_) for a_, b_ in zip(fr, last_read)) / size > 6):
        reads.append(t); last_read = fr
    if cuts and abs(cuts[-1] - t) < 1e-6 and (not reads or reads[-1] != t):
        reads.append(t); last_read = fr
    prev = fr
p.wait()
end_seg(opt["from"] + k / opt["fps"])

# ---------- its sound, as a few numbers when it changes (perch_sound.py) ----------
if sound and not opt.get("nosound"):
    try:
        import perch_sound
        for t, l in perch_sound.lines(src, opt["from"], opt["to"], ts): lines.append((t, 6, l))
    except Exception as e:
        lines.append((opt["from"], 6, f"! sound not read: {type(e).__name__}"))

# ---------- speech as words (Whisper) and sounds by name (YAMNet), both on this machine; skipped, and said, when not set up ----------
MODELS = os.environ.get("PERCH_MODELS", os.path.expanduser("~/.cache/perch-models"))
WHISPER = os.environ.get("PERCH_WHISPER", os.path.join(MODELS, "whisper.cpp", "build", "bin", "whisper-cli"))
WMODEL = os.environ.get("PERCH_WHISPER_MODEL", os.path.join(MODELS, "whisper.cpp", "models", f"ggml-{opt.get('quality', 'base')}.bin"))
BETTER = os.path.join(MODELS, "whisper.cpp", "models", "ggml-small.bin")      # tried by the player itself when a piece stays unclear
VADM = os.environ.get("PERCH_VAD_MODEL", os.path.join(MODELS, "whisper.cpp", "models", "ggml-silero-v5.1.2.bin"))
TAGPY = os.environ.get("PERCH_TAG_PYTHON", os.path.join(MODELS, "venv", "bin", "python"))
def tag_runs():
    """the tagger's sound runs [(t0, t1, name, score)], or None without a tagger"""
    tagger = os.path.join(HERE, "perch_tag.py") if os.path.isfile(os.path.join(HERE, "perch_tag.py")) else "/usr/lib/perch/perch_tag.py"
    if not (os.access(TAGPY, os.X_OK) and os.path.isfile(os.path.join(MODELS, "yamnet", "yamnet.tflite"))): return None
    r = subprocess.run([TAGPY, tagger, os.path.join(MODELS, "yamnet"), src, str(opt["from"]), str(opt["to"]) if opt["to"] else "-"],
                       capture_output=True, text=True, timeout=1800)
    out = []
    for l in r.stdout.splitlines():
        try: e = json.loads(l); out.append((e["t0"], e["t1"], e["name"], e["score"]))
        except (ValueError, KeyError): pass
    return out
VOICE = re.compile(r"speech|singing|sing|choir|vocal|rapping|narration|conversation|chant|yodel|whisper|shout|babbl|monolog", re.I)
def loop(words):
    """a made-up loop: the same few words over and over (Whisper does this on noise, or in a wrong language); also any text that
    zips down far more than speech does (Whisper's own test: a compression ratio over 2.4)"""
    import zlib
    b = words.encode()
    if len(b) > 60 and len(b) / len(zlib.compress(b)) > 2.4: return True
    w = words.lower().split()
    for n in (1, 2, 3, 4):
        for i in range(0, max(0, len(w) - n * 5) + 1):
            if all(w[i + j * n: i + (j + 1) * n] == w[i: i + n] for j in range(5)): return True
    return False
# ---------- lessons: what this video taught the player, kept per video on this machine, used next time, told to the bot ----------
LESSONS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "perch", "video-lessons.json")
def video_key():
    import hashlib
    h = hashlib.sha256()
    try:
        with open(src, "rb") as f: h.update(f.read(1 << 20))
        h.update(str(os.path.getsize(src)).encode())
    except OSError:
        h.update(src.encode())                                  # an address: the address itself
    return h.hexdigest()[:24]
def lessons_load():
    try: return json.load(open(LESSONS))
    except (OSError, ValueError): return {}
VKEY = video_key()
known = lessons_load().get(VKEY, {})
if known.get("about"):
    lines.append((opt["from"], 0, f"! from lessons: seen before ({known.get('seen', '?')}), about: {known['about']}" +
                  (f"; summary then: {known['summary']}" if known.get("summary") else "")))
if known.get("lang") and opt.get("lang", "auto") == "auto" and not opt.get("hint"):
    opt["hint"] = known["lang"]; lines.append((opt["from"], 0, f"! from lessons: lang {known['lang']} (this video taught it before; still checked)"))
adjusted_to = []                                                 # languages the player had to switch to here
runs = tag_runs() if sound and not opt.get("nosound") else None
if sound and not opt.get("nosound") and (opt.get("speech") or not textsubs):
    if os.access(WHISPER, os.X_OK) and os.path.isfile(WMODEL):
        end = opt["to"] if opt["to"] is not None else dur
        langs, a = [], opt["from"]
        while a < end - 0.3:
            b = min(end, a + 30.0)
            if runs is not None and not any(VOICE.search(n) and t0 < b and t1 > a for t0, t1, n, sc in runs):
                a = b; continue                                    # only music or noise here: nothing to hear as words
            wav, base = os.path.join(RUN, "speech.wav"), os.path.join(RUN, "speech")
            subprocess.run(FF + ["-ss", str(a), "-i", src, "-t", str(b - a), "-vn", "-ac", "1", "-ar", "16000", "-y", wav], capture_output=True, timeout=600)
            def hear(lang, model):
                """one try: (segments [(t, words)], language, how many loops)"""
                try: os.remove(base + ".json")
                except OSError: pass
                subprocess.run([WHISPER, "-m", model, "-f", wav, "-l", lang, "-mc", "0", "-np", "-ojf", "-of", base], capture_output=True, text=True, timeout=1800)
                try: j = json.load(open(base + ".json"))
                except (OSError, ValueError): return [], None, 1
                segs, loops = [], 0
                for seg in j.get("transcription", []):
                    words = (seg.get("text") or "").strip()
                    if not words or re.fullmatch(r"[\[(].*[\])]", words): continue          # [music], (applause): the sound lines say those
                    if loop(words): loops += 1; continue
                    ps = [tk.get("p", 0) for tk in seg.get("tokens", []) if not str(tk.get("text", "")).startswith("[_")]
                    sure = 1 + round(10 * min(1.0, max(0.0, ((sum(ps) / len(ps)) if ps else 0.5) - 0.4) / 0.6))   # 1..11 (Mike's scale)
                    segs.append((a + seg.get("offsets", {}).get("from", 0) / 1000, words, sure))
                return segs, (j.get("result") or {}).get("language") or (None if lang == "auto" else lang), loops
            want = opt.get("lang", "auto")
            prefer = opt.get("hint") if want == "auto" else None        # a language a piece before needed: tried first, still checked
            segs, lang, loops = hear(prefer or want, WMODEL)
            if prefer and (loops or not segs):
                segs, lang, loops = hear("auto", WMODEL)
            if loops and want == "auto":
                # the player adjusts itself: the language the clear pieces were in, else English; then the better model; the clearest wins
                tries = [(l, WMODEL) for l in dict.fromkeys(langs + ["en"]) if l != lang]
                if os.path.isfile(BETTER) and BETTER != WMODEL: tries += [("auto", BETTER)] + [(l, BETTER) for l in dict.fromkeys(langs + ["en"])]
                best = (len(" ".join(w for _, w, _s in segs).split()) - 50 * loops, segs, lang, loops, None)
                for l, m in tries:
                    s2, lang2, loops2 = hear(l, m)
                    score = len(" ".join(w for _, w, _s in s2).split()) - 50 * loops2
                    if score > best[0]: best = (score, s2, lang2, loops2, (l, m))
                    if loops2 == 0 and s2: break
                _, segs, lang, loops, how = best
                if how and how[0] != "auto": opt["hint"] = how[0]; adjusted_to.append((how[0], lang))   # the next pieces try this language first
                if how: lines.append((a, 1, f"! adjusted {ts(a)} lang {how[0]}" + (f" quality {os.path.basename(how[1])[5:-4]}" if how[1] != WMODEL else "") + " (the first try made loops)"))
            for t, words, sure in segs: lines.append((t, 1, f"say {ts(t)} sure {sure} {q(words)}"))
            if loops: lines.append((a, 1, f"! speech unclear {ts(a)}-{ts(b)} (try: back, set lang, set quality)"))
            if segs and lang and lang not in langs: langs.append(lang)
            a = b
        if langs: head += " speech:" + ",".join(langs)
    else:
        lines.append((opt["from"], 1, "! speech not read: no Whisper here (see the README)"))
if sound and not opt.get("nosound"):
    if runs is None: lines.append((opt["from"], 6, "! sounds not named: no sound tagger here (see the README)"))
