    os.close(wg); os.close(wf)
    gq = queue.Queue()
    def grey_reader():                                          # the small stream on its own thread, so neither pipe can stall the other
        with os.fdopen(rg, "rb") as f:
            while True:
                b = f.read(size)
                gq.put(b if len(b) == size else None)
                if len(b) < size: return
    threading.Thread(target=grey_reader, daemon=True).start()
    fq = queue.Queue(maxsize=32)                                # full frames: their own thread too (ffmpeg writes the two
    def full_reader():                                          # streams in its own order: one reader waiting on the other locks up)
        n = W_ * H_ * 3
        with os.fdopen(rf, "rb", buffering=0) as f:
            while True:
                b = bytearray(n); mv = memoryview(b); got = 0
                while got < n:
                    r_ = f.readinto(mv[got:])
                    if not r_: break
                    got += r_
                fq.put(bytes(b) if got == n else None)
                if got < n: return
    threading.Thread(target=full_reader, daemon=True).start()
    def frames():                                               # (grey bytes, full frame bytes) in step
        while True:
            g = gq.get()
            if g is None: return
            yield g, fq.get()
