def ocr(t, im):
    try:
        if not (reader and reader.available()): return t, []
        return t, [w_ for *_, w_ in reader.read(im, [(0, 0, im.width, im.height)], page=True)]
    finally:
        room.release()
def take(t, im, is_cut, grey, box=None):                        # a chosen frame: its words read, and described if it is a new scene
    global n_frames, n_seen
    if im is None: return
    n_frames += 1
    room.acquire(); ocr_jobs.append(ocr_pool.submit(ocr, t, im))
    if opt["describe"] and is_cut:
        if opt.get("detail") == "quick" and grey is not None and perch_cuts:   # quick: like a scene already described: not again
            near = min(((perch_cuts.shifted(grey, g0), t0) for g0, t0 in described), default=(999, None))
            if near[0] < 20:
                lines.append((t, 5, f"see {ts(t)} like {ts(near[1])}")); return
            described.append((grey, t))
        n_seen += 1; see_jobs.append(see_pool.submit(see_line, t, im, box))

