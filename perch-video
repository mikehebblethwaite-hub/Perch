            d_ = [abs(a - b) for a, b in zip(fr, pv)]; whole = sum(d_) / size
            ha = [0] * 16; hb = [0] * 16
            for a_, b_ in zip(fr, pv): ha[a_ >> 4] += 1; hb[b_ >> 4] += 1
            is_cut = whole > 28 and sum(abs(a_ - b_) for a_, b_ in zip(ha, hb)) / (2 * size) > 0.35
            cells = [i for i in range(9) if sum(1 for y in range(GH)[CELLS[i][0]] for x in range(GW)[CELLS[i][1]] if d_[y * GW + x] > 18) >
                     (CELLS[i][0].stop - CELLS[i][0].start) * (CELLS[i][1].stop - CELLS[i][1].start) * 0.04]
        else:
            d_ = np.abs(fr - pv)
            cells = [i for i, (ys, xs) in enumerate(CELLS) if (d_[ys, xs] > 18).mean() > 0.04]
        if is_cut:
            end_seg(t); cuts.append(t); lines.append((t, 2, f"cut {ts(t)} {len(cuts) + 1}"))
        elif cells:
            c = centre(cells)
