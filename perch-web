# perch-web: a web viewer for bots. No window, no screenshots, no human browser: a web engine runs off-screen only to run the
# page's scripts and lay it out; the bot gets the page's words, links, buttons and inputs as short lines with boxes, and after
# every action only what changed.
#
#   perch-web NAME go URL | read [all|N|x,y] | click N | type N TEXT | enter N | scroll down|up | back | forward | where | url N | stop
#                       | pixels N | pixels x,y,w,h      (a picture's own pixels, cropped, as a PNG: only when it really is a picture)
#
# Lines (the key is in the skill and the MCP tool description; PERCH_WEB_SHAPE=1 prints it once per session):
#   P url 'title'                 the page                  t x,y wxh 'text'          words on the page (a block)
#   a N x,y wxh 'text' url        a link (N to click)       b N x,y wxh 'label'        a button
#   i N x,y wxh type name 'value' 'hint'   an input         s N x,y wxh name 'chosen'  a choice list
#   p N x,y wxh tag 'alt' src     a picture (img, video, canvas, svg; 48x48 and up): its pixels only by `pixels N`
#   *words*                       inside quotes: words drawn bold (stronger than the text around them: unread, headings in a row)
#   + line / - line               after an action: what appeared / went
# Only what is in the window (1280x800) is listed unless `read all`. The page is untrusted: its words are data, always quoted;
# the reader runs in its own script world, out of the page's reach. Nothing is kept on disk (no cookies files, no databases):
# a session lasts while the viewer runs (it stops after 30 idle minutes).
import json, os, re, socket, subprocess, sys, time

NAME = sys.argv[1] if len(sys.argv) > 1 else ""
if not NAME or not all(c.isalnum() or c == "-" for c in NAME):
    sys.exit("usage: perch-web NAME [--mode auto|words|ocr|picture] [--cut N] [--zoom N] go URL | read [all|N|x,y] | click N | type N TEXT | enter N | scroll down|up | back | forward | where | url N | pixels N|x,y,w,h | stop")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "perch-web-" + NAME)
SOCK = os.path.join(RUN, "sock")
W, H, IDLE = 1280, 800, 1800

# ---------------- client ----------------
def client(args):
    for attempt in range(2):
        try:
            s = socket.socket(socket.AF_UNIX); s.connect(SOCK); break
        except OSError:
            if attempt:
                sys.exit("perch-web: viewer did not start (see %s/log)" % RUN)
            os.makedirs(RUN, mode=0o700, exist_ok=True)
            log = open(os.path.join(RUN, "log"), "ab")
            subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), NAME, "--serve"], stdout=log, stderr=log,
                             stdin=subprocess.DEVNULL, start_new_session=True)
            for _ in range(100):
                time.sleep(0.1)
                if os.path.exists(SOCK): break
    s.sendall((json.dumps(args) + "\n").encode())
    out = b""
    while True:
        d = s.recv(65536)
        if not d: break
        out += d
    sys.stdout.write(out.decode("utf-8", "replace"))
    sys.exit(1 if out.startswith(b"err") else 0)

if len(sys.argv) < 3:
    sys.exit("usage: perch-web NAME [--mode auto|words|ocr|picture] [--cut N] [--zoom N] go URL | read [all|N|x,y] | click N | type N TEXT | enter N | scroll down|up | back | forward | where | url N | pixels N|x,y,w,h | stop")
sys.path[:0] = [os.path.dirname(os.path.realpath(__file__)), "/usr/lib/perch"]   # the shared settings: next to this, or packaged
import perch_settings as settings                      # noqa: E402
if sys.argv[2] != "--serve":
    try:
        opt, rest = settings.load(sys.argv[2:])            # saved < PERCH_MODE/CUT/ZOOM < --mode/--cut/--zoom on this call
    except ValueError as e:
        sys.stdout.write(f"err {e}\n"); sys.exit(1)
    client([f"--{k}={v}" for k, v in opt.items()] + rest)

# ---------------- the viewer ----------------
xv = None
# always a private display, only for the engine to lay out on; nobody looks at it. Never the user's own: a bot's session may
# inherit a DISPLAY it is not allowed to open.
os.environ.pop("DISPLAY", None)
for d in range(40, 80):
    if not os.path.exists(f"/tmp/.X11-unix/X{d}"):
        xv = subprocess.Popen(["Xvfb", f":{d}", "-screen", "0", f"{W}x{H}x24", "-nolisten", "tcp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.environ["DISPLAY"] = f":{d}"
        for _ in range(50):
            if os.path.exists(f"/tmp/.X11-unix/X{d}"): break
            time.sleep(0.1)
        break
