WORLD = "perch"
# Text drawn on a canvas never reaches the page's words: it goes from the page's script straight to pixels. This runs in the
# page's own world before its scripts and notes each fillText/strokeText (the text, where, how big, after the canvas's own
# transform) on the canvas as data-perch-canvas, once a frame; a full clear starts a new frame. The reader turns them into
# t lines: the words exactly as the page asked them drawn, no OCR. (A page could write that attribute itself: it can say
# false things about its own canvas, as it can in its own text. Quoted words stay data.)
CANVAS_HOOK = r"""(() => {
  const P = window.CanvasRenderingContext2D && CanvasRenderingContext2D.prototype; if (!P || P.__perch) return;
  Object.defineProperty(P, '__perch', {value: true});
  const real = {fill: P.fillText, stroke: P.strokeText, clear: P.clearRect, rect: P.fillRect}, MAX = 400, dirty = new Set();
  const lists = new WeakMap();
  const flush = () => { for (const c of dirty) { try { c.setAttribute('data-perch-canvas', JSON.stringify(lists.get(c) || [])); } catch (e) {} } dirty.clear(); };
  const touch = c => { if (!dirty.size) setTimeout(flush, 0); dirty.add(c); };
  const whole = (ctx, x, y, w, h) => { const c = ctx.canvas, m = ctx.getTransform();
    return m.a * x + m.e <= 0 && m.d * y + m.f <= 0 && m.a * (x + w) + m.e >= c.width && m.d * (y + h) + m.f >= c.height; };
  const note = (ctx, text, x, y) => { try {
    const c = ctx.canvas; if (!c || !c.setAttribute) return; text = String(text).slice(0, 200); if (!/\S/.test(text)) return;
    const m = ctx.getTransform(), X = m.a * x + m.c * y + m.e, Y = m.b * x + m.d * y + m.f;
    const px = parseFloat((/(\d+(?:\.\d+)?)px/.exec(ctx.font) || [0, 10])[1]) * Math.abs(m.d || 1);
    const w = real.measure.call(ctx, text).width * Math.abs(m.a || 1);
    const b = ctx.textBaseline, a = ctx.textAlign, rtl = ctx.direction === 'rtl';
    const top = b === 'top' ? Y : b === 'middle' ? Y - px / 2 : (b === 'bottom' || b === 'ideographic') ? Y - px : Y - px * 0.8;
    const left = a === 'center' ? X - w / 2 : (a === 'right' || (a === 'end' && !rtl) || (a === 'start' && rtl)) ? X - w : X;
    let l = lists.get(c); if (!l) { l = []; lists.set(c, l); }
    const k = Math.round(left) + ',' + Math.round(top);
    for (let i = l.length - 1; i >= 0; i--) if (l[i][0] + ',' + l[i][1] === k) l.splice(i, 1);   // drawn again at the same place
    l.push([Math.round(left), Math.round(top), Math.round(w), Math.round(px), text]); if (l.length > MAX) l.shift();
    touch(c); } catch (e) {} };
  real.measure = P.measureText;
  P.fillText = function (t, x, y, ...r) { note(this, t, x, y); return real.fill.call(this, t, x, y, ...r); };
  P.strokeText = function (t, x, y, ...r) { note(this, t, x, y); return real.stroke.call(this, t, x, y, ...r); };
  const reset = (ctx, x, y, w, h) => { try { if (whole(ctx, x, y, w, h) && lists.get(ctx.canvas)?.length) { lists.set(ctx.canvas, []); touch(ctx.canvas); } } catch (e) {} };
  P.clearRect = function (x, y, w, h) { reset(this, x, y, w, h); return real.clear.call(this, x, y, w, h); };
  P.fillRect = function (x, y, w, h) { reset(this, x, y, w, h); return real.rect.call(this, x, y, w, h); };
})();"""
READER = r"""
(function(all){
  const W = innerWidth, H = innerHeight, out = [];
  let next = +(document.documentElement.getAttribute('data-perch-next') || 1);
  const idOf = el => { let v = el.getAttribute('data-perch'); if (!v) { v = String(next++); el.setAttribute('data-perch', v); } return v; };
  const vis = el => { const r = el.getBoundingClientRect(); if (r.width < 1 || r.height < 1) return null;
    const cs = getComputedStyle(el); if (cs.visibility === 'hidden' || cs.display === 'none' || +cs.opacity === 0) return null;
    if (!all && (r.bottom < 0 || r.top > H || r.right < 0 || r.left > W)) return null; return r; };
  const box = r => Math.round(r.left) + ',' + Math.round(r.top) + ' ' + Math.round(r.width) + 'x' + Math.round(r.height);
  const clean = t => (t || '').replace(/\s+/g, ' ').trim().slice(0, 300);
  // words as drawn: runs bolder than their own block are *marked* (a screenshot shows them bold: unread mail, a name in a row)
  const wt = e => parseInt(getComputedStyle(e).fontWeight) || 400;
  const blk = e => { while (e && e.parentElement && getComputedStyle(e).display.startsWith('inline')) e = e.parentElement; return e; };
  const shown = e => e.getClientRects().length && getComputedStyle(e).visibility !== 'hidden';
  const marked = (nodes, base) => { const seg = []; let lb = null;
    for (const t of nodes) { const p = t.parentElement; if (!p || !shown(p)) continue;
      const bk = blk(p), sp = lb && bk !== lb ? ' ' : ''; lb = bk;
      const bold = /\S/.test(t.data) ? base < 600 && wt(p) >= 600 : (seg.length ? seg[seg.length - 1][0] : false);
      if (seg.length && seg[seg.length - 1][0] === bold) seg[seg.length - 1][1] += sp + t.data; else seg.push([bold, sp + t.data]); }
    return seg.map(([b, x]) => b && /\S/.test(x) ? x.replace(/^(\s*)([\s\S]*?)(\s*)$/, '$1*$2*$3') : x).join(''); };
  const textNodes = el => { const r = [], w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    for (let t; (t = w.nextNode());) if (!/^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE)$/.test(t.parentElement.tagName)) r.push(t); return r; };
  const rich = el => marked(textNodes(el), wt(el));
  // a link on this site is said relative to the P line's address (said once), not in full every time
  // the look carries a short address (the bot clicks by number; `url N` gives the whole one): a jump on this page = '#', another
  // site = //host/path, a long query = '?…', a long path cut with '…'
  const rel = h => { try { const u = new URL(h); if (!/^(https?|file):$/.test(u.protocol)) return h.length > 60 ? h.slice(0, 59) + '…' : h;
      if (u.origin === location.origin && u.pathname === location.pathname && u.search === location.search) return u.hash ? '#' : '.';
      if (u.origin === location.origin && u.pathname === location.pathname) return u.search.length > 21 ? '?…' : (u.search || u.pathname.split('/').pop() || '/');   // this page, another query (or none)
      let p = u.pathname; if (p.length > 60) p = p.slice(0, 59) + '…';
      const qs = u.search.length > 21 ? '?…' : u.search;
      return (u.origin === location.origin ? '' : (u.protocol === 'https:' ? '//' : u.protocol + '//') + u.host) + p + qs;
    } catch (e) {} return h.length > 60 ? h.slice(0, 59) + '…' : h; };
  const act = 'a[href],button,input,textarea,select,[role=button],[role=link],[role=tab],[role=menuitem],[contenteditable=true],summary';
  const taken = new Set();
  for (const el of document.querySelectorAll(act)) {
    const r = vis(el); if (!r) continue; taken.add(el);
    const n = idOf(el), tag = el.tagName.toLowerCase();
    if (tag === 'a' || el.getAttribute('role') === 'link') out.push(['a', n, box(r), clean(rich(el) || el.getAttribute('aria-label') || el.title), rel(el.href || '').slice(0, 200)]);
    else if (tag === 'input' || tag === 'textarea' || el.isContentEditable) {
      const ty = tag === 'textarea' ? 'textarea' : el.isContentEditable ? 'editable' : (el.type || 'text');
      if (ty === 'hidden') continue;
      const v = ty === 'password' ? (el.value ? '***' : '') : ty === 'checkbox' || ty === 'radio' ? (el.checked ? 'on' : 'off') : clean(el.value || (el.isContentEditable ? el.innerText : ''));
      out.push(['i', n, box(r), ty, (el.name || el.id || '').slice(0, 40), v, clean(el.placeholder || el.getAttribute('aria-label') || '')]);
    } else if (tag === 'select') out.push(['s', n, box(r), (el.name || el.id || '').slice(0, 40), clean(el.selectedOptions[0] ? el.selectedOptions[0].text : '')]);
    else out.push(['b', n, box(r), clean(rich(el) || el.value || el.getAttribute('aria-label') || el.title)]);
  }
  // pictures: things that are pixels by nature (a photo, a chart drawn on a canvas, a video), 48x48 and up (smaller = icons)
  for (const el of document.querySelectorAll('img,video,canvas,svg,[role=img]')) {
    if (el.parentElement && el.parentElement.closest('svg,[role=img]')) continue;
    const r = vis(el); if (!r || r.width < 48 || r.height < 48) continue;
    const tag = el.tagName.toLowerCase(), src = el.currentSrc || el.src || '';
    out.push(['p', idOf(el), box(r), tag, clean(el.alt || el.getAttribute('aria-label') || el.title || ''), !src ? '-' : src.startsWith('data:') ? 'data:' : rel(src).slice(0, 200)]);
  }
  document.documentElement.setAttribute('data-perch-next', String(next));
  // words: each block's own text (text nodes not inside a link/button/input already listed)
  const blocks = new Map();
  const tw = document.createTreeWalker(document.body || document.documentElement, NodeFilter.SHOW_TEXT);
  for (let t; (t = tw.nextNode());) {
    let el = t.parentElement, skip = false;          // spaces too: they part words in bold and plain runs
    for (let p = el; p; p = p.parentElement) { if (taken.has(p) || /^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE)$/.test(p.tagName)) { skip = true; break; } }
    if (skip) continue;
    let b = el; while (b && b.parentElement && getComputedStyle(b).display.startsWith('inline')) b = b.parentElement;
    if (!blocks.has(b)) blocks.set(b, []);
    blocks.get(b).push(t);
  }
  for (const [b, nodes] of blocks) { const r = vis(b); if (!r) continue; const tx = clean(marked(nodes, wt(b)));
    if (tx && /[\p{L}\p{N}]/u.test(tx)) out.push(['t', '', box(r), tx]); }   // no letter or digit = decoration (sparkles, dots)
  for (const c of document.querySelectorAll('canvas[data-perch-canvas]')) {      // words the page drew on a canvas (CANVAS_HOOK)
    const r = vis(c); if (!r || !c.width || !c.height) continue; let l; try { l = JSON.parse(c.getAttribute('data-perch-canvas')); } catch (e) { continue; }
    if (!Array.isArray(l)) continue; const sx = r.width / c.width, sy = r.height / c.height;
    for (const e of l.slice(-400)) { if (!Array.isArray(e) || e.length !== 5 || typeof e[4] !== 'string') continue;
      const tx = clean(e[4]); if (!tx || !/[\p{L}\p{N}]/u.test(tx)) continue;
      out.push(['t', '', box({left: r.left + e[0] * sx, top: r.top + e[1] * sy, width: Math.max(1, e[2] * sx), height: Math.max(1, e[3] * sy)}), tx]); } }
  return JSON.stringify({url: location.href, title: document.title.slice(0, 200), sy: Math.round(scrollY), ph: document.documentElement.scrollHeight, items: out});
})(%s)
"""

def q(t):
    t = str(t or "")
    return "'" + "".join(("\\" + c) if c in "\\'" else ("\\n" if c == "\n" else (c if c >= " " else "?")) for c in t) + "'"

def line(it):
    k = it[0]
    if k == "a": return f"a {it[1]} {it[2]} {q(it[3])} {it[4]}"
    if k == "i": return f"i {it[1]} {it[2]} {it[3]} {it[4] or '-'} {q(it[5])} {q(it[6])}"
    if k == "s": return f"s {it[1]} {it[2]} {it[3] or '-'} {q(it[4])}"
    if k == "b": return f"b {it[1]} {it[2]} {q(it[3])}"
    if k == "p": return f"p {it[1]} {it[2]} {it[3]} {q(it[4])} {it[5]}"
    return f"t {it[2]} {q(it[3])}"

SHAPE = ("# shape: P url 'title' scroll/height | t x,y wxh 'text' | a N box 'text' url (on this site: from the P address) | b N box 'label' | i N box type name 'value' 'hint' | "
         "s N box name 'chosen' | p N box tag 'alt' src = a picture (pixels N gives its pixels) | *words* = drawn bold | + = appeared since the last answer | - X N (or - t x,y) = went | = X N [box] (or = t x,y) = came back as told (box only if moved) | "
         "N-M = a run of numbers | "
         "~ = moved (new box) | ! = what happened | v = box: just below the line above, same left edge and size")
SHAPE_ON = os.environ.get("PERCH_WEB_SHAPE") == "1"    # a bot with neither the skill nor the MCP tools: print the key once

def pack(ls):
    """a line just below the line above, with the same left edge, width and height, writes v for its box (lists, menus, rows):
    "a 2 200,151 1064x45 ..." under "a 1 200,106 1064x45 ..." -> "a 2 v ...". Only in what the bot is sent; the lines kept stay whole."""
    out, prev = [], None
    for l in ls:
        f = l.split(" "); i = 1 if f[0] == "t" else 2
        try:
            x, y = map(int, f[i].split(",")); w, h = map(int, f[i + 1].split("x"))
        except (ValueError, IndexError):
            out.append(l); prev = None; continue
        if prev and prev == (x, w, h, y - h): out.append(" ".join(f[:i] + ["v"] + f[i + 2:]))
        else: out.append(l)
        prev = (x, w, h, y)
    return out

def ident(l):
    """a line without its box: the same thing at a new place has the same identity"""
    return tuple(p for i, p in enumerate(l.split(" ")) if not (i in (1, 2) and l[0] == "t" or i in (2, 3) and l[0] != "t"))

def key(l):
    return (l[0], l.split(" ")[1] if l[0] != "t" else "") + ident(l)

def runs(ls):
    """numbered lines of one kind in a row become one range: "- a 1", "- a 2", "- a 3" -> "- a 1-3" """
    out, run = [], None
    for l in ls:
        f = l.split(" ")
        if len(f) == 3 and f[2].isdigit():
            if run and run[0] == (f[0], f[1]) and int(f[2]) == run[2] + 1:
                run[2] = int(f[2]); continue
            if run: out.append(f"{run[0][0]} {run[0][1]} {run[1]}" + (f"-{run[2]}" if run[2] != run[1] else ""))
            run = [(f[0], f[1]), int(f[2]), int(f[2])]; continue
        if run: out.append(f"{run[0][0]} {run[0][1]} {run[1]}" + (f"-{run[2]}" if run[2] != run[1] else "")); run = None
        out.append(l)
    if run: out.append(f"{run[0][0]} {run[0][1]} {run[1]}" + (f"-{run[2]}" if run[2] != run[1] else ""))
    return out

class Viewer:
    def __init__(self):
        ctx = WebKit2.WebContext.new_ephemeral()               # nothing on disk
        ucm = WebKit2.UserContentManager()
        ucm.add_script(WebKit2.UserScript.new(CANVAS_HOOK, WebKit2.UserContentInjectedFrames.ALL_FRAMES,
                                              WebKit2.UserScriptInjectionTime.START, None, None))
        self.web = WebKit2.WebView(web_context=ctx, user_content_manager=ucm)
        st = self.web.get_settings()
        st.set_enable_developer_extras(False); st.set_enable_webaudio(False); st.set_media_playback_requires_user_gesture(True)
        st.set_enable_webgl(False); st.set_enable_page_cache(False)
        self.win = Gtk.OffscreenWindow(); self.win.set_default_size(W, H); self.win.add(self.web); self.win.show_all()
        self.loading = False; self.last = []; self.told = {}; self.shape_sent = False; self.used = time.time(); self.opt = dict(settings.DEFAULTS)
        self.web.connect("load-changed", self.on_load)
        self.web.connect("create", lambda *a: None)             # no pop-up windows
        self.web.connect("script-dialog", self.on_dialog)
        self.dialog = ""

    def on_dialog(self, w, d):
        self.dialog = d.get_message()[:200]
        return True                                             # never block on alert/confirm: noted, answered "cancel"

    def on_load(self, w, ev):
        self.loading = ev != WebKit2.LoadEvent.FINISHED

    def js(self, script, done):
        def cb(w, res):
            try:
                v = w.evaluate_javascript_finish(res)
                done(v.to_string() if v and not v.is_undefined() else "")
            except GLib.Error as e:
                done(None, e.message)
        self.web.evaluate_javascript(script, -1, WORLD, None, None, cb)

    def settle(self, then, t0=None, quiet=0):
        """wait until loaded and the page has stopped changing (300 ms quiet), at most 12 s"""
        t0 = t0 or time.time()
        def tick():
            if time.time() - t0 > 12: then(); return False
            if self.loading: self.settle_q = 0; return True
            self.js("String(document.readyState) + (document.body ? document.body.innerHTML.length : 0)", lambda v, e=None: setattr(self, "probe", v))
            p = getattr(self, "probe", None)
            if p is not None and p == getattr(self, "probe_last", None):
                self.settle_q = getattr(self, "settle_q", 0) + 1
                if self.settle_q >= 3: self.probe_last = None; self.settle_q = 0; then(); return False
            else:
                self.settle_q = 0
            self.probe_last = p
            return True
        GLib.timeout_add(100, tick)

    def read(self, all_, done, diff=True):
        def got(v, e=None):
            try:
                got2(v, e)
            except Exception as x:                              # guard: a reader fault answers the bot, never hangs it
                done(f"err the page could not be read: {type(x).__name__}\n")
        def got2(v, e=None):
            if not v: done(f"err the page could not be read{': ' + e if e else ''}\n"); return
            d = json.loads(v)
            lines = [line(it) for it in d["items"]]
            head = f"P {d['url'][:300]} {q(d['title'])} {d['sy']}/{d['ph']}"
            out = []
            if SHAPE_ON and not self.shape_sent: out.append(SHAPE); self.shape_sent = True   # the skill and the MCP tools carry the key
            if self.dialog: out.append("! dialog " + q(self.dialog)); self.dialog = ""
            out.append(head)
            full = not (diff and self.last and not all_)          # the whole look (a new page, read), not only what changed
            mode = self.opt["mode"]
            if mode == "picture" or (mode == "ocr" and full):
                self.last = lines
                self.told.update((key(l), l.split(" ")[2] if l[0] != "t" else l.split(" ")[1]) for l in lines)
                self.answer_pixels(mode, out, done); return
            if diff and self.last and not all_:
                old, new = set(self.last), set(lines)
                gone = [l for l in self.last if l not in new]; came = [l for l in lines if l not in old]
                gk = {}
                for l in gone: gk.setdefault(key(l), []).append(l)
                moved, came2 = [], []
                for l in came:
                    k = key(l)
                    if gk.get(k):
                        gk[k].pop(0)
                        f = l.split(" ")
                        moved.append("~ " + (f"t {f[1]} {f[2]} " + " ".join(f[3:])[:40] if l[0] == "t" else f"{f[0]} {f[1]} {f[2]} {f[3]}"))
                    else:
                        came2.append(l)
                gone2 = [l for ls in gk.values() for l in ls]
                # the bot was told these words already: what went is named by its number (or place), what comes back unchanged is "="
                short = lambda l: (lambda f: f"{f[0]} {f[1]}" if l[0] != "t" else f"t {f[1].split('x')[0] if 'x' in f[1] else f[1]}")(l.split(" "))
                # back at the same place as when told: number only; elsewhere: number + new box
                back = lambda l: (lambda f: f"= {f[0]} {f[1]}" + ("" if self.told.get(key(l)) == f[2] else f" {f[2]} {f[3]}"))(l.split(" "))
                # words come back as "= t x,y" only at the same place as told (a word block has no number to carry a new box)
                told = lambda l: key(l) in self.told and (l[0] != "t" or self.told[key(l)] == l.split(" ")[1])
                seen = [back(l) if l[0] != "t" else "= t " + l.split(" ")[1] for l in came2 if told(l)]
                new = ["+ " + l for l in pack([l for l in came2 if not told(l)])]
                out += runs(["- " + short(l) for l in gone2]) + runs(seen) + new + moved
                if not gone2 and not came2 and not moved: out.append("! no change")
            else:
                body = pack(lines)
                if not all_: body = [settings.cut(l, self.opt["cut"]) for l in body]   # read N / read all: whole lines
                if mode == "auto" and not all_:
                    words = settings.tokens_words("\n".join(body))
                    pic = settings.tokens_picture(W * self.opt["zoom"] // 100, H * self.opt["zoom"] // 100)
                    if words > pic:                           # the picture is the smaller answer for this screen
                        self.last = lines
                        self.told.update((key(l), l.split(" ")[2] if l[0] != "t" else l.split(" ")[1]) for l in lines)
                        out.append(f"! picture: the words would be ~{words} tokens (read --mode words for them)")
                        self.answer_pixels("picture", out, done); return
                out += body
            if not all_: self.last = lines
            self.told.update((key(l), l.split(" ")[2] if l[0] != "t" else l.split(" ")[1]) for l in lines)
            done("\n".join(out) + "\n")
        self.js(READER % ("true" if all_ else "false"), got)

    def answer_pixels(self, mode, out, done):
        """picture: the window zoomed out; ocr: the window's words read from its pixels here (R lines, no tokens to read)"""
        pb = self.win.get_pixbuf()
        if not pb: done("\n".join(out + ["err no picture of the window yet"]) + "\n"); return
        path = os.path.join(RUN, "screen.png"); pb.savev(path, "png", [], [])
        from PIL import Image
        im = Image.open(path); im.load()
        if mode == "picture":
            out.append(settings.picture(im, self.opt["zoom"], path))
        else:
            import perch_read as reader
            if not reader.available(): out.append("err ocr needs tesseract (apt install tesseract-ocr)")
            else:
                r = reader.read(im, [(0, 0, im.width, im.height)], page=True)
                out += [settings.cut(f"R {x},{y} {w}x{h} {reader.quote(t)}", self.opt["cut"]) for x, y, w, h, t in r] or ["! no words read"]
        done("\n".join(out) + "\n")

    def read_one(self, what, done):
        """read N: line N whole (a link, button, box, picture); read x,y: the words at that place whole"""
        for l in self.last:
            f = l.split(" ")
            if (what.isdigit() and l[0] != "t" and f[1] == what) or (l[0] == "t" and f[1] == what):
                done(l + "\n"); return
        done("err no such line (read again: numbers are per page)\n")

    def pixels(self, what, done):
        """a picture's own pixels, cropped to it (or to a box of the window): a PNG beside the socket, never the whole page"""
        def crop(x, y, w, h, n):
            pb = self.win.get_pixbuf()
            x0, y0 = max(0, int(x)), max(0, int(y)); x1, y1 = min(W, int(x + w)), min(H, int(y + h))
            if not pb or x1 - x0 < 1 or y1 - y0 < 1:
                done("err nothing to crop there (off the window: scroll first)\n"); return False
            path = os.path.join(RUN, f"pixels-{n}.png")
            pb.new_subpixbuf(x0, y0, x1 - x0, y1 - y0).savev(path, "png", [], [])
            done(f"pixels {n} {path} {x1 - x0}x{y1 - y0} ~{(x1 - x0) * (y1 - y0) // 750} tokens\n"); return False
        f = what.split(",")
        if len(f) == 4 and all(v.isdigit() for v in f):
            x, y, w, h = map(int, f); GLib.timeout_add(50, lambda: crop(x, y, w, h, f"{x}-{y}-{w}-{h}")); return
        if not what.isdigit():
            done("err pixels N (a p line's number) or pixels x,y,w,h\n"); return
        def got(v, e=None):
            if not v or v == "null": done(f"err {e or 'no such picture (read again: numbers are per page)'}\n"); return
            r = json.loads(v)
            GLib.timeout_add(300, lambda: crop(r[0], r[1], r[2], r[3], what))    # let the scroll paint first
        self.js(f"""(e => {{ if (!e) return null; e.scrollIntoView({{block:'center'}}); const r = e.getBoundingClientRect();
                  return JSON.stringify([r.left, r.top, r.width, r.height]); }})(document.querySelector('[data-perch="{int(what)}"]'))""", got)

    def do(self, args, done):
        self.used = time.time()
        self.opt = dict(settings.DEFAULTS)
        while args and args[0].startswith("--") and "=" in args[0]:
            k, v = args[0][2:].split("=", 1); args = args[1:]
            try: self.opt[k] = settings.check(k, v)
            except ValueError as e: done(f"err {e}\n"); return
        c = args[0] if args else ""
        by = lambda n: f"document.querySelector('[data-perch=\"{int(n)}\"]')"
        def after_action(msg=None):
            def go_read():
                self.read(False, lambda txt: done((f"! {msg}\n" if msg else "") + txt))
            self.settle(go_read)
        def run(script, ok_msg):
            def cb(v, e=None):
                if v in (None, "", "false"): done(f"err {e or 'no such element (read again: numbers are per page)'}\n"); return
                after_action(ok_msg)
            self.js(script, cb)
        try:
            if c == "go" and len(args) == 2:
                u = args[1]
                if u.startswith("/"): u = "file://" + u                 # a page on this machine (the bot may read it anyway)
                elif not u.startswith(("http://", "https://", "file://")): u = "https://" + u
                self.last = []; self.loading = True; self.web.load_uri(u); after_action()
            elif c == "read" and len(args) == 2 and re.fullmatch(r"\d+|\d+,\d+", args[1]):
                self.read_one(args[1], done)
            elif c == "read":
                self.read(len(args) > 1 and args[1] == "all", done, diff=False)
            elif c == "click" and len(args) == 2 and args[1].isdigit():
                run(f"(e => {{ if (!e) return false; e.scrollIntoView({{block:'center'}}); e.focus(); e.click(); return true; }})({by(args[1])})", f"clicked {args[1]}")
            elif c == "type" and len(args) >= 3 and args[1].isdigit():
                txt = json.dumps(" ".join(args[2:]))
                run(f"""(e => {{ if (!e) return false; e.focus();
                      if (e.isContentEditable) e.innerText = {txt}; else {{ const p = Object.getPrototypeOf(e); const d = Object.getOwnPropertyDescriptor(p, 'value');
                      d && d.set ? d.set.call(e, {txt}) : (e.value = {txt}); }}
                      e.dispatchEvent(new Event('input', {{bubbles:true}})); e.dispatchEvent(new Event('change', {{bubbles:true}})); return true; }})({by(args[1])})""", f"typed in {args[1]}")
            elif c == "enter" and len(args) == 2 and args[1].isdigit():
                run(f"""(e => {{ if (!e) return false; e.focus();
                      for (const t of ['keydown','keypress','keyup']) e.dispatchEvent(new KeyboardEvent(t, {{key:'Enter', code:'Enter', keyCode:13, which:13, bubbles:true}}));
                      if (e.form) {{ e.form.requestSubmit ? e.form.requestSubmit() : e.form.submit(); }} return true; }})({by(args[1])})""", f"enter in {args[1]}")
            elif c == "scroll" and len(args) == 2 and args[1] in ("down", "up"):
                run(f"(scrollBy(0, {'' if args[1] == 'down' else '-'}{int(H * 0.8)}), true)", f"scrolled {args[1]}")
            elif c in ("back", "forward"):
                (self.web.go_back if c == "back" else self.web.go_forward)(); after_action(c)   # changes only: what was told comes back as "="
            elif c == "pixels" and len(args) == 2:
                self.pixels(args[1], done)
            elif c == "url" and len(args) == 2 and args[1].isdigit():
                self.js(f"(e => e ? String(e.href || e.currentSrc || e.src || '') : null)({by(args[1])})",
                        lambda v, e=None: done(f"url {args[1]} {v}\n" if v and v != "null" else "err no such number (read again: numbers are per page)\n"))
            elif c == "where":
                done(f"P {self.web.get_uri()} {q(self.web.get_title())}\n")
            elif c == "stop":
                done("ok stopping\n"); GLib.timeout_add(200, lambda: (Gtk.main_quit(), False)[1])
            else:
                done("err say: go URL | read [all|N|x,y] | click N | type N TEXT | enter N | scroll down|up | back | forward | where | url N | pixels N|x,y,w,h | stop\n")
        except Exception as e:
            done(f"err {type(e).__name__}: {str(e)[:200]}\n")

V = Viewer()
