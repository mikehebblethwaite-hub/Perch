old = os.umask(0o077)
svc = Gio.SocketService.new()
svc.add_address(Gio.UnixSocketAddress.new(SOCK), Gio.SocketType.STREAM, Gio.SocketProtocol.DEFAULT, None)
os.umask(old)

def incoming(service, conn, src):
    stream = Gio.DataInputStream.new(conn.get_input_stream())
    def got(s, res):
        try:
            l, _ = s.read_line_finish_utf8(res)
            args = json.loads(l or "[]")
            if not isinstance(args, list) or not all(isinstance(a, str) for a in args): raise ValueError
        except Exception:
            args = []
        def done(text):
            try:
                conn.get_output_stream().write_all(text.encode("utf-8"), None); conn.close(None)
            except GLib.Error:
                pass
        V.do(args[:40], done)
    stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)
    return False
svc.connect("incoming", incoming)
svc.start()
GLib.timeout_add_seconds(60, lambda: (Gtk.main_quit() if time.time() - V.used > IDLE else None) or True)
Gtk.main()
