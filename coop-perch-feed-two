# coop-perch-feed-two: build-2's memory once a second, as raw lines for coop-perch-feed (meminfo, --, RSS_KB NAME, ==).
exec ssh -o ServerAliveInterval=15 build-2 'while :; do cat /proc/meminfo; echo --; ps -eo rss=,comm= --sort=-rss | head -16; echo ==; sleep 1; done'
