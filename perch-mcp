                                    "words, each line of a full look cut short; ocr = words read from the pixels; picture = a zoomed-out "
                                    "picture (a fixed price); auto = words, or the picture when that is smaller"},
        "cut": {"type": "integer", "description": "a full look cuts each line to this many characters (0 = whole lines; 20-400)"},
        "zoom": {"type": "integer", "description": "picture size, % of the screen (25-100)"}}


def flags(a):
    """the look settings a bot chose for this call, checked, as command-line flags"""
    out = []
    if "look_as" in a: out.append("--mode=" + need(a, "look_as", re.compile(r"^(auto|words|ocr|picture)$")))
    for k, lo, hi in (("cut", 0, 400), ("zoom", 25, 100)):
        if k in a:
            v = need(a, k, kind=int)
            if isinstance(v, bool) or not lo <= v <= hi or (k == "cut" and 0 < v < 20):
                raise Bad(f"{k}: " + ("0 or 20 to 400" if k == "cut" else "25 to 100"))
            out.append(f"--{k}={v}")
    return out


