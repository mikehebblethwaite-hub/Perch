legend{{font-weight:700;margin-bottom:8px;padding:0}}
.mode{{display:grid;grid-template-columns:22px 1fr;column-gap:10px;padding:12px 14px;background:var(--panel);border:1px solid var(--rule);
  border-radius:10px;margin-bottom:8px;cursor:pointer}}
.mode:has(input:checked){{border-color:var(--perch);box-shadow:inset 4px 0 0 var(--perch)}}
.mode input{{grid-row:span 2;margin:4px 0 0;accent-color:var(--perch);width:18px;height:18px}}
