# perch-settings: how Perch answers a bot's look (web pages, a display, VMs), saved in ~/.config/perch/settings.json.
#   perch-settings                    what is set now
#   perch-settings set KEY VALUE      mode auto|words|ocr|picture · cut 0|20-400 · zoom 25-100
#   perch-settings reset              back to auto, 60, 50
#   perch-settings page               a settings page on this machine only (127.0.0.1, a one-off key in the address,
#                                          stops after 15 idle minutes), with a live preview of what a bot would get
# One call can still choose for itself: --mode / --cut / --zoom on perch-web, perch-look, perch-vmlook,
# or look_as / cut / zoom in the MCP tools.
import html, json, os, secrets, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [HERE, "/usr/lib/perch"]
import perch_settings as settings                      # noqa: E402

USAGE = ("usage: perch-settings [set mode auto|words|ocr|picture | set cut 0|20-400 | set zoom 25-100 | reset | page]")
first = lambda *ps: next((p for p in ps if os.path.exists(p)), ps[0])
# the made-up inbox shipped with Perch (the preview never opens a real page) and the site's fonts: in the repo, or packaged
SAMPLE = first(os.path.join(HERE, "demo", "inbox.html"), "/usr/share/perch/inbox.html")
FONTS = first(os.path.join(HERE, "site", "assets", "fonts"), "/usr/share/perch/fonts")
SCREENSHOT = settings.tokens_picture(1280, 800)             # one full screenshot of the same window, for comparison


def ok(k, v):
    try: settings.check(k, v); return True
    except ValueError: return False


def show(s):
    src = "saved" if os.path.exists(settings.PATH) else "defaults (nothing saved yet)"
    try:
        d = json.load(open(settings.PATH))
        bad = [k for k in settings.DEFAULTS if k in d and not ok(k, d[k])]
        if bad: src = f"saved, but {', '.join(bad)} not allowed there, so the default is used"
    except (OSError, ValueError):
        if os.path.exists(settings.PATH): src = "the saved file cannot be read, so the defaults are used"
    return (f"mode {s['mode']}\ncut {s['cut']}\nzoom {s['zoom']}\n({src}: {settings.PATH})\n")


args = sys.argv[1:]
if not args:
    sys.stdout.write(show(settings.saved())); sys.exit(0)
if args[0] == "set" and len(args) == 3:
    s = settings.saved()
    try:
        s[args[1]] = settings.check(args[1], args[2])
    except ValueError as e:
        sys.exit(f"err {e}")
    sys.stdout.write(show(settings.save(s))); sys.exit(0)
if args == ["reset"]:
    sys.stdout.write(show(settings.save(dict(settings.DEFAULTS)))); sys.exit(0)
if args != ["page"]:
    sys.exit(USAGE)

# ---------------- the page ----------------
KEY = secrets.token_urlsafe(18)
last_used = [time.time()]
preview_lock = threading.Lock()

MODES = [
    ("auto", "Let Perch choose", "Words first. When the words would cost more than a small picture, the bot gets the picture."),
    ("words", "Words", "The screen's own words and numbered buttons. Long lines are cut short; the bot asks for any line in full."),
    ("ocr", "Read the pixels", "Words read from what is drawn, here on this machine. For apps that give no words of their own."),
    ("picture", "Picture", "A small picture of the whole screen. The same price however busy the screen is."),
]
CUTS = [(0, "Never: whole lines"), (40, "40 characters"), (60, "60 characters"), (80, "80 characters"), (120, "120 characters")]
ZOOMS = [(25, "25%: the size of a stamp"), (35, "35%"), (50, "50%: readable"), (75, "75%"), (100, "100%: a full screenshot")]


def preview(s):
    """what a bot would get from the sample inbox with these settings: the real answer and its cost"""
    with preview_lock:
        name = "settings-preview"
        run = lambda *a: subprocess.run([os.path.join(HERE, "perch-web"), name, *a], capture_output=True, text=True, timeout=90).stdout
        out = run(f"--mode={s['mode']}", f"--cut={s['cut']}", f"--zoom={s['zoom']}", "go", SAMPLE)
        run("stop")
    pic = None
    for l in out.splitlines():
        if l.startswith("pixels screen "):
            path = l.split()[2]
            try:
                import base64
                pic = "data:image/png;base64," + base64.b64encode(open(path, "rb").read()).decode()
            except OSError:
                pass
            cost = int(l.rsplit("~", 1)[1].split()[0])
            break
    else:
        cost = settings.tokens_words(out)
    return {"text": out, "picture": pic, "tokens": cost, "screenshot": SCREENSHOT}


def options(name, items, chosen):
    return "".join(f'<option value="{v}"{" selected" if v == chosen else ""}>{html.escape(t)}</option>' for v, t in items)


def page(s, note=""):
    modes = "".join(
        f'''<label class="mode"><input type="radio" name="mode" value="{v}"{" checked" if v == s["mode"] else ""}>
        <span class="mode-name">{html.escape(t)}</span><span class="mode-what">{html.escape(d)}</span></label>''' for v, t, d in MODES)
    return f'''<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Perch settings</title><style>
@font-face{{font-family:"Atkinson Hyperlegible";src:url(/{KEY}/font/r) format("truetype");font-weight:400}}
@font-face{{font-family:"Atkinson Hyperlegible";src:url(/{KEY}/font/b) format("truetype");font-weight:700}}
@font-face{{font-family:"Perch Mono";src:url(/{KEY}/font/m) format("truetype")}}
:root{{--bg:#eef1f3;--panel:#fff;--ink:#17232c;--ink2:#4a5863;--muted:#6f7c87;--rule:#d3dae0;--shot:#eb6834;--perch:#2a78d6;--screen:#f7f9fa;
  --sans:"Atkinson Hyperlegible",system-ui,sans-serif;--mono:"Perch Mono","DejaVu Sans Mono",monospace;color-scheme:light}}
@media (prefers-color-scheme:dark){{:root{{--bg:#11181d;--panel:#1a2329;--ink:#edf1f3;--ink2:#b9c4cc;--muted:#8d9aa5;--rule:#2c3942;
  --shot:#d95926;--perch:#3987e5;--screen:#141c21;color-scheme:dark}}}}
*{{box-sizing:border-box}}
body{{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 var(--sans)}}
main{{max-width:1080px;margin:0 auto;padding:32px 16px 48px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:32px;align-items:start}}
