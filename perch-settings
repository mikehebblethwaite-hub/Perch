</style></head><body><main>
<section>
<h1>How your bot sees a screen</h1>
<p class="lede">Choose what Perch hands a bot when it looks. These settings are kept on this machine and used by every look,
web pages, your display and virtual machines, unless the bot asks for something else on one call.</p>
<form method="post" action="/{KEY}/save" id="f">
<fieldset><legend>Each look gives the bot</legend>{modes}</fieldset>
<fieldset><legend><label for="cut">Cut long lines after</label></legend>
<select name="cut" id="cut">{options("cut", CUTS, s["cut"])}</select>
<p class="help">Only on a whole look. Changes after an action always come whole.</p></fieldset>
<fieldset><legend><label for="zoom">Picture size</label></legend>
<select name="zoom" id="zoom">{options("zoom", ZOOMS, s["zoom"])}</select>
<p class="help">Used by Picture, and by Let Perch choose when it picks the picture.</p></fieldset>
<button type="submit">Save settings</button><p class="saved" id="note" role="status">{html.escape(note)}</p>
</form>
</section>
<aside aria-labelledby="pv">
<h2 id="pv" style="font-size:20px;margin:6px 0 4px">What the bot gets</h2>
<p class="help" style="margin:0 0 12px">A first look at Perch's sample inbox with these settings, made just now.</p>
<div class="cost">
<span>This look</span><span class="bar"><i class="p" id="bp" style="width:0"></i></span><span class="num" id="np">…</span>
<span>A screenshot</span><span class="bar"><i class="s" id="bs" style="width:100%"></i></span><span class="num" id="ns">{SCREENSHOT:,} tokens</span>
</div>
<div class="screen" id="screen"><pre>Making the preview…</pre></div>
</aside>
</main>
<script>
const f = document.getElementById('f'), screen = document.getElementById('screen'), note = document.getElementById('note');
let ask = 0;
function current() {{ const d = new FormData(f); return {{mode: d.get('mode'), cut: d.get('cut'), zoom: d.get('zoom')}}; }}
async function refresh() {{
  const n = ++ask; screen.classList.add('busy');
  try {{
    const r = await fetch('/{KEY}/preview?' + new URLSearchParams(current()));
    const j = await r.json(); if (n !== ask) return;
    if (!r.ok) throw new Error(j.error || 'the preview did not come');
    screen.replaceChildren();
    if (j.picture) {{ const im = new Image(); im.src = j.picture; im.alt = 'The picture the bot would get'; screen.append(im); }}
    const pre = document.createElement('pre'); pre.textContent = j.text; screen.append(pre);
    document.getElementById('np').textContent = '~' + j.tokens.toLocaleString('en-GB') + ' tokens';
    document.getElementById('bp').style.width = Math.min(100, 100 * j.tokens / j.screenshot) + '%';
  }} catch (e) {{
    if (n === ask) {{ screen.replaceChildren(); const p = document.createElement('pre'); p.className = 'err';
      p.textContent = 'No preview: ' + e.message + '. Is perch-web working? Try: perch-web test go ' + {json.dumps(SAMPLE)}; screen.append(p); }}
  }} finally {{ if (n === ask) screen.classList.remove('busy'); }}
}}
f.addEventListener('change', () => {{ note.textContent = ''; refresh(); }});
refresh();
</script></body></html>'''


class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def send(self, code, body, ctype="text/html; charset=utf-8"):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store"); self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; "
                         "font-src 'self'; img-src data:; connect-src 'self'; form-action 'self'; base-uri 'none'")
        try:
            self.end_headers(); self.wfile.write(b)
        except (BrokenPipeError, ConnectionResetError):
            pass                                            # the browser left (a reload, a closed tab): nothing to answer

    def ok(self):
        """only this machine, only by the address with this run's key (another site in the browser cannot guess it)"""
        last_used[0] = time.time()
        host = self.headers.get("Host", "")
        return host == f"127.0.0.1:{PORT}" and self.path.startswith(f"/{KEY}/")

    def do_GET(self):
        if not self.ok(): return self.send(404, "not here\n", "text/plain")
        p, _, qs = self.path[len(KEY) + 2:].partition("?")
        if p == "":
            return self.send(200, page(settings.saved()))
        if p.startswith("font/") and p[5:] in ("r", "b", "m"):
            f = {"r": "AtkinsonHyperlegible-Regular.ttf", "b": "AtkinsonHyperlegible-Bold.ttf", "m": "DejaVuSansMono.ttf"}[p[5:]]
            try: return self.send(200, open(os.path.join(FONTS, f), "rb").read(), "font/ttf")
            except OSError: return self.send(404, "", "text/plain")
        if p == "preview":
            from urllib.parse import parse_qs
            q = {k: v[0] for k, v in parse_qs(qs).items()}
            try:
                s = {k: settings.check(k, q.get(k, settings.DEFAULTS[k])) for k in settings.DEFAULTS}
            except ValueError as e:
                return self.send(400, json.dumps({"error": str(e)}), "application/json")
            try:
                return self.send(200, json.dumps(preview(s)), "application/json")
            except Exception as e:
                return self.send(500, json.dumps({"error": type(e).__name__}), "application/json")
        self.send(404, "not here\n", "text/plain")

    def do_POST(self):
        if not self.ok() or self.path != f"/{KEY}/save": return self.send(404, "not here\n", "text/plain")
        from urllib.parse import parse_qs
        n = int(self.headers.get("Content-Length") or 0)
        if n > 2000: return self.send(413, "too long\n", "text/plain")
        q = {k: v[0] for k, v in parse_qs(self.rfile.read(n).decode("utf-8", "replace")).items()}
        try:
            s = settings.save({k: q.get(k, settings.DEFAULTS[k]) for k in settings.DEFAULTS})
        except ValueError as e:
            return self.send(400, page(settings.saved(), "Not saved: " + str(e)))
        self.send(200, page(s, "Saved. Every look uses these now."))


srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
PORT = srv.server_address[1]
print(f"Perch settings: http://127.0.0.1:{PORT}/{KEY}/\n(this machine only; stops after 15 idle minutes, or Ctrl+C)", flush=True)
threading.Thread(target=srv.serve_forever, daemon=True).start()
try:
    while time.time() - last_used[0] < 900:
        time.sleep(5)
except KeyboardInterrupt:
    pass
srv.shutdown()
