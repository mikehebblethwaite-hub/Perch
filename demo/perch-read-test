# perch-read-test NAME [ROUNDS] [OTHER_PAGE]: a fair test of the learning reader on a Perch VM's real screen.
# Words: the window in front gives its own words (T lines): the truth. They are split in two: the reader learns from one half (a
#   fresh memory, nothing learned before), then reads the other half from pixels and is scored word by word: as read, and with the
#   seed lessons and what it learned. ROUNDS: the halves are drawn again.
# Pictures: the named places with no letters (icons) of this window are learned; then OTHER_PAGE (a file in the guest, opened by
#   the hands in Edge) is the other window, and its named pictures are scored: recognised by their look, or not.
import json, os, random, re, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
P = os.path.dirname(HERE)
sys.path.insert(0, P)
os.environ["PERCH_LEARN_DIR"] = tempfile.mkdtemp(prefix="perch-read-test-")
import perch_read as reader  # noqa: E402

if len(sys.argv) < 2:
    sys.exit("usage: perch-read-test NAME [ROUNDS]")
NAME, ROUNDS = sys.argv[1], int(sys.argv[2]) if len(sys.argv) > 2 else 4
look = subprocess.run([os.path.join(P, "perch-vmlook"), NAME, "window"], capture_output=True, text=True).stdout
T = re.compile(r"^T \S+ (-?\d+),(-?\d+) (\d+)x(\d+) \+'((?:[^'\\]|\\.)*)'$")
truths = [(int(m[1]), int(m[2]), int(m[3]), int(m[4]), re.sub(r"\\(.)", r"\1", m[5])) for m in map(T.match, look.splitlines()) if m]
# fair truth: what can be on the screen as it is. A box taller than one line (a list row) is named with words the screen cuts off
# ("…"), so it is left out: the reader must not be marked wrong for words that are not there to read.
truths = [t for t in truths if (10 <= t[3] <= 30 or (t[3] <= 80 and t[2] <= 80)) and t[2] >= 12 and 2 <= len(t[4]) <= 120 and "…" not in t[4]
          and (reader.fits(t[2], t[3], t[4]) or (t[2] <= 80 and len(t[4].split()) <= 3))]
if len(truths) < 8:
    sys.exit(f"only {len(truths)} lines of the apps' own words on the screen: open a window with more words")
import importlib.machinery  # noqa: E402
vm = importlib.machinery.SourceFileLoader("vmlook", os.path.join(P, "perch-vmlook"))
im = None
# the screen, once (the same pixels for every round)
import json as _j, socket  # noqa: E402
run = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "perch-vm-" + NAME)
ppm = os.path.join(run, "read-test.ppm")
c = socket.socket(socket.AF_UNIX); c.connect(os.path.join(run, "qmp")); f = c.makefile("rw"); f.readline()
for cmd in ({"execute": "qmp_capabilities"}, {"execute": "screendump", "arguments": {"filename": ppm}}):
    f.write(_j.dumps(cmd) + "\n"); f.flush()
    while not re.search(r'"(return|error)"', f.readline() or '"error"'): pass
from PIL import Image  # noqa: E402


def grab():
    c = socket.socket(socket.AF_UNIX); c.connect(os.path.join(run, "qmp")); f = c.makefile("rw"); f.readline()
    for cmd in ({"execute": "qmp_capabilities"}, {"execute": "screendump", "arguments": {"filename": ppm}}):
        f.write(_j.dumps(cmd) + "\n"); f.flush()
        while not re.search(r'"(return|error)"', f.readline() or '"error"'): pass
    f.close(); c.close()
    i = Image.open(ppm); i.load(); os.remove(ppm); return i


im = Image.open(ppm); im.load(); os.remove(ppm)
f.close(); c.close()                # QEMU's control line takes one caller at a time: let go before the next grab
reads = {}
for t in truths:                     # every place read from pixels once, raw (no memory): the same reading for both scores
    got = reader.read(im, [(t[0] - 4, t[1] - 3, t[2] + 8, t[3] + 6)], conf=0)
    reads[t] = " ".join(g[4] for g in got)
pictures = [t for t in truths if t[2] <= 80 and t[3] <= 80 and len(t[4].split()) <= 3 and reader.is_picture(reads[t], t[4])]
truths = [t for t in truths if t not in pictures]
tot = {"words": 0, "raw": 0, "fixed": 0}
examples = []
for r in range(ROUNDS):
    random.Random(r).shuffle(truths)
    half = len(truths) // 2
    learn, test = truths[:half], truths[half:]
    mem = reader.Memory(f"test-{r}")
    for t in learn:
        mem.learn(reads[t], t[4])
    for t in test:
        words = t[4].split(); raw = reads[t].split(); fixed = mem.fix(reads[t]).split()
        tot["words"] += len(words); tot["raw"] += reader._same(raw, words); tot["fixed"] += reader._same(fixed, words)
        if fixed != words and len(examples) < 8 and (reads[t], t[4]) not in [(a, c) for a, b, c in examples]:
            examples.append((reads[t], mem.fix(reads[t]), t[4]))
pc = lambda k: tot[k] / tot["words"] * 100
print(f"screen: {NAME}, {len(truths)} lines of the apps' own words, {ROUNDS} rounds (learn on one half, score the other)")
print(f"words read right: {pc('raw'):.1f}% as read, {pc('fixed'):.1f}% with what it learned ({tot['words']} words scored)")
for a, b, t in examples:
    print(f"  read {a!r} -> fixed {b!r} (truth {t!r})")
# pictures: learned here, recognised in another window
pic = {"learned": len(pictures), "scored": 0, "right": 0}
other = sys.argv[3] if len(sys.argv) > 3 else None
if pictures and other:
    mem = reader.Memory("test-pictures")
    for t in pictures:
        mem.learn_picture(im.crop((t[0], t[1], t[0] + t[2], t[1] + t[3])), t[4])
    act = os.path.join(P, "perch-act")
    subprocess.run([act, NAME, "key super+r"], capture_output=True); import time; time.sleep(2)
    subprocess.run([act, NAME, f"type msedge --app=file:///{other} --start-maximized --no-first-run", "key return"], capture_output=True)
    time.sleep(8); subprocess.run([os.path.join(P, "perch-wait"), "-t", "15", "-p", "vm-" + NAME], capture_output=True); time.sleep(2)
    look2 = subprocess.run([os.path.join(P, "perch-vmlook"), NAME, "window"], capture_output=True, text=True).stdout
    t2 = [(int(m[1]), int(m[2]), int(m[3]), int(m[4]), re.sub(r"\\(.)", r"\1", m[5])) for m in map(T.match, look2.splitlines()) if m]
    im2 = grab()
    for t in t2:
        if t[2] <= 80 and t[3] <= 80 and len(t[4].split()) <= 3:
            got = reader.read(im2, [(t[0], t[1], t[2], t[3])], conf=0, memory=mem)
            said = " ".join(g[4] for g in got)
            if not said.startswith("[") and not reader.is_picture(said, t[4]):
                continue                                   # words on it: not a picture
            pic["scored"] += 1; pic["right"] += said == "[" + t[4] + "]"
            print(f"  picture {t[4]!r} in the other window: {said or 'not recognised'}")
    print(f"pictures: {pic['learned']} learned in this window; in the other window {pic['right']} of {pic['scored']} recognised by their look")
out = os.path.join(P, "tape", "read-test"); os.makedirs(out, exist_ok=True)
json.dump({"lines": len(truths), "rounds": ROUNDS, "pictures": pic, **tot}, open(os.path.join(out, "result.json"), "w"))
import shutil  # noqa: E402
shutil.rmtree(os.environ["PERCH_LEARN_DIR"], ignore_errors=True)       # the test's own fresh memories: not kept
print("result: " + os.path.join(out, "result.json"))
